{
  "name": "@repo/server-core",
  "version": "0.1.0",
  "private": true,
  "description": "Edura shared server kernel — HTTP envelope/errors, scoped DB wrappers, rate limiting, validation, notification dispatch, and the money-engine primitives used by both apps/www and apps/superadmin. Drift-critical code lives here exactly once.",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "@repo/notifications": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "better-auth": "1.6.25",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "pdf-lib": "^1.17.1",
    "posthog-node": "^5.47.3",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "@types/node": "26.1.1",
    "@types/web-push": "^3.6.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  }
}
