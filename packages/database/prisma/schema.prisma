enum InvitePurpose {
  student_activation
  teacher_activation
  admin_invite
  walk_in_onboarding // Step 7: tokenized walk-in claim link (phone-only shell student)
  // Email invites for the two staff-shaped roles. Same Step 7 machinery: an
  // opaque single-use token whose HASH is all that persists. The purpose IS the
  // authorization gate — the claim provider maps purpose -> the exactly-one
  // role it may resolve to, so a token minted for an assistant can never open a
  // staff (or student) account.
  assistant_invite
  center_staff_invite
  // An OFF-SYSTEM teacher who decided to join after all. Same kernel, same five
  // gates; the live-link gate for this purpose is an ACTIVE affiliation plus
  // system_status='enrolled', so flipping the teacher back to external (or
  // ending the affiliation) kills an outstanding invite without hunting for the
  // token. NOTE: the older `teacher_activation` value above is NOT this — it is
  // minted by roster.inviteTeacher and has never had a consumer.
  teacher_invite
  // Child safety: proves the guardian address actually reaches someone.
  // NOT claimable — a token of this purpose mints no session, it only flips
  // guardian_email_verified_at. See CLAIMABLE in invite-token.ts.
  guardian_email_verification


  @@map("invite_purpose")
}

