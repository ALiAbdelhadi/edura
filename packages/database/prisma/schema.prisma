// =============================================================================
// better-auth (2026-08-01) — DB-backed auth sessions, credential accounts,
// verification store, TOTP 2FA. NOTE: `AuthSession` is deliberately NOT named
// `Session` — that model is the live-class engine and is untouched.
// `users.password_hash` remains the SINGLE SOURCE OF TRUTH for the credential;
// auth_accounts.password is a mirror kept in sync by credentialSyncExtension
// (packages/database/src/extensions) — never write it directly.
// =============================================================================

model AuthSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String   @unique
  userId         String   @map("user_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  // admin plugin (impersonation — superadmin app only, UI in a later workstream)
  impersonatedBy String?  @map("impersonated_by")
  // Session-scoped center claim, resolved by resolveLoginCenterId at sign-in
  // (center_admin → profile, center_staff → live link). Mirror of the old JWT
  // `centerId` claim. Authoritative staff revocation stays requireCenterActor.
  centerId       String?  @map("center_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
