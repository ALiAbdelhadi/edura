enum NotificationType {
  absence_marked
  attendance_corrected
  session_cancelled
  session_postponed
  course_cancelled
  grade_entered
  material_uploaded
  payment_recorded
  payment_refunded
  enrollment_request_submitted
  enrollment_request_approved
  enrollment_request_declined
  student_added_to_roster
  teacher_invited
  parent_link_requested
  admin_broadcast
  password_reset_requested
  shell_activation_invite
  registration_approved
  registration_rejected
  blacklist_action
  // H-04: a lifted blacklist restored a student into a course that filled up
  // while they were out — the owning center/teacher is told it is over cap.
  enrollment_restored_over_capacity
  payout_approved
  classroom_request
  classroom_request_decided
  lesson_reminder
  homework_deadline
  invite_code_sent
  // Child safety: a MINOR still has no guardian email, so adult-facing
  // messaging stays locked. Sent to the student/parent side as a reminder and,
  // once the deadline passes, to the owning center as an escalation.
  guardian_contact_required
  new_chat_message
  chat_group_message
  chat_report_filed
  // Team notes: a new note tells the rest of the team; a status flip
  // (done/declined) tells the note's author.
  team_note_created
  team_note_status_changed

  @@map("notification_type")
}

enum BotType {
  support
  academic

  @@map("bot_type")
}

// ---- Education catalog (onboarding) ----
// NOTE: the catalog itself (systems/stages/grades/tracks/subjects) is DATA,
// never enums — the whole point is admin-managed config with zero deploys.
// Only the administrative workflow status below is an enum.

enum SubjectRequestStatus {
  pending
  approved
  rejected

  @@map("subject_request_status")
}

// =============================================================================
// CORE IDENTITY
// =============================================================================

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String?    @unique
  phone         String?    @unique
  passwordHash  String?    @map("password_hash")
  role          Role
  name          String
  locale        Locale     @default(ar)
  theme         Theme      @default(system)
  status        UserStatus @default(active)
  emailVerified Boolean    @default(false) @map("email_verified")
  // L1: monotonic session epoch. Every JWT records the value at issue time; the
  // NextAuth jwt callback rejects any token whose recorded value < this column.
  // Bumped on password reset/change so all pre-existing 30-day tokens (e.g. an
  // attacker's after a compromise) are invalidated at once — server-side
  // revocation for otherwise-stateless sessions.
  tokenVersion  Int        @default(0) @map("token_version")
  fcmToken      String?    @map("fcm_token")
  // Demo/seed data marker so it can be purged before launch. Flagged on root
  // entities only (users, centers, courses); child rows inherit by ancestry.
  isDemo        Boolean    @default(false) @map("is_demo")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)

  studentProfile     StudentProfile?
  parentProfile      ParentProfile?
  teacherProfile     TeacherProfile?
  centerAdminProfile CenterAdminProfile?
  prefs              UserPrefs?

  @@index([role])
  @@index([status])
  @@map("users")
}

model StudentProfile {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String?    @unique @map("user_id") @db.Uuid // NULL for temporary/invited students (PRD)
  fullName                String     @map("full_name")
  phone                   String?
  grade                   String? // DEPRECATED free text — superseded by gradeLevelId (education catalog)
  familyLinkCode          String     @unique @map("family_link_code")
  // Welcome-email idempotency stamp: the sender claims it atomically
  // (updateMany WHERE null) so duplicate/retried sign-ups mail exactly once.
  onboardingEmailSentAt   DateTime?  @map("onboarding_email_sent_at") @db.Timestamptz(6)
  // Step 6: typeable Student ID ("STU-000123") for counter check-in; DB default
  // covers every creation site, migration backfilled existing rows.
  studentCode             String     @unique @default(dbgenerated("gen_student_code()")) @map("student_code")
  entityType              EntityType @default(registered) @map("entity_type")
  inviteCode              String?    @unique @map("invite_code")
  // ---- Child safety (messaging oversight). DEFAULT-MINOR by design: a student
  // counts as an adult ONLY when a VERIFIED date of birth proves 18+. Missing,
  // unverified, or under-18 all mean MINOR, so parent oversight stays active.
  // Erring toward more protection is the safe failure mode on a K-12 platform;
  // see isMinor() in src/queries/chat-minors.ts — the single implementation.
  dateOfBirth             DateTime?  @map("date_of_birth") @db.Date
  // Set by a super admin once the DOB is evidenced. NULL ⇒ unverified ⇒ minor,
  // no matter what dateOfBirth says.
  dateOfBirthVerifiedAt   DateTime?  @map("date_of_birth_verified_at") @db.Timestamptz(6)
  dateOfBirthVerifiedBy   String?    @map("date_of_birth_verified_by") @db.Uuid
  // ---- Guardian contact channel (child safety, approved 2026-07-25).
  // A MINOR must have a reachable GUARDIAN EMAIL before adult-facing messaging
  // (teacher / assistant / center admin / center staff) opens. See
  // hasGuardianChannel() in src/queries/chat-guardian.ts — the single rule.
  //
  // The phone is captured when the guardian has no email (very common at a
  // walk-in counter): it is kept for the record and for a future SMS/WhatsApp
  // channel, but it NEVER satisfies the gate — the gate is email-only by
  // decision, because that is the channel we can actually deliver on today.
  guardianEmail           String?    @map("guardian_email")
  guardianPhone           String?    @map("guardian_phone")
  guardianEmailAddedAt    DateTime?  @map("guardian_email_added_at") @db.Timestamptz(6)
  guardianEmailAddedBy    String?    @map("guardian_email_added_by") @db.Uuid
  // Deadline for supplying the email. Purely an ESCALATION marker: passing it
  // never suspends the account (the student paid) and never unlocks messaging.
  // Before it, reminders are periodic; after it, the banner turns persistent
  // and the owning center is notified.
  guardianContactDueAt    DateTime?  @map("guardian_contact_due_at") @db.Timestamptz(6)
  pointsBalance           Int        @default(0) @map("points_balance")
  // Student money wallet (piasters). Cached balance — the append-only
  // WalletLedger is the source of truth; reconciles as SUM(delta) == this ==
  // last balanceAfter. DB CHECK (wallet_balance >= 0) is the H2-style floor.
  walletBalance           Int        @default(0) @map("wallet_balance")
  savedAreaCity           String?    @map("saved_area_city")
  savedAreaLat            Float?     @map("saved_area_lat")
  savedAreaLng            Float?     @map("saved_area_lng")
  invitationSentAt        DateTime?  @map("invitation_sent_at") @db.Timestamptz(6)
  claimedAt               DateTime?  @map("claimed_at") @db.Timestamptz(6)
  // ---- Education catalog (onboarding §4). stage/system stored alongside
  // gradeLevel per the PRD; the API layer enforces chain consistency.
  // Catalog FKs are ON DELETE RESTRICT: admins hide via is_active, never
  // hard-delete rows students still point at.
  educationSystemId       String?    @map("education_system_id") @db.Uuid
  stageId                 String?    @map("stage_id") @db.Uuid
  gradeLevelId            String?    @map("grade_level_id") @db.Uuid
  trackId                 String?    @map("track_id") @db.Uuid
  secondLanguageSubjectId String?    @map("second_language_subject_id") @db.Uuid
  onboardingCompleted     Boolean    @default(false) @map("onboarding_completed")
  onboardingDraft         Json?      @map("onboarding_draft") // wizard auto-save (§9)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User?            @relation(fields: [userId], references: [id])
  educationSystem       EducationSystem? @relation(fields: [educationSystemId], references: [id], onDelete: Restrict)
  stage                 Stage?           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  gradeLevel            GradeLevel?      @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  track                 Track?           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  secondLanguageSubject Subject?         @relation("StudentSecondLanguage", fields: [secondLanguageSubjectId], references: [id], onDelete: Restrict)

  @@index([gradeLevelId, trackId]) // content-matching hot path
  @@index([guardianContactDueAt]) // reminder-escalation sweep
  @@map("student_profiles")
}

model ParentProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  walletBalance Int      @default(0) @map("wallet_balance") // piasters; DB CHECK (>= 0), H2
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("parent_profiles")
}

model TeacherProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  bio                 String?
  subjects            String[] // DEPRECATED free text — superseded by teacher_subjects (education catalog)
  qualifications      String?
  experienceYears     Int      @default(0) @map("experience_years")
  photoUrl            String?  @map("photo_url")
  lessonPrice         Int?     @map("lesson_price") // piasters (PRD teacher_profiles.lesson_price)
  ratingAvg           Float    @default(0) @map("rating_avg")
  ratingCount         Int      @default(0) @map("rating_count")
  walletBalance       Int      @default(0) @map("wallet_balance") // piasters; DB CHECK (>= 0), H2
  certificates        Json? // [{name, file_url, issued_by}]
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  onboardingDraft     Json?    @map("onboarding_draft") // wizard auto-save (§9)
  // Step 6: global per-teacher check-in mode (approved decision #4).
  attendanceMode      AttendanceMode @default(counter_only) @map("attendance_mode")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                @relation(fields: [userId], references: [id])
  gradeLevels TeacherGradeLevel[]
  subjectRefs TeacherSubject[]

  @@index([subjects])
  @@map("teacher_profiles")
}

model CenterAdminProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  centerId  String   @map("center_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id])
  center Center @relation(fields: [centerId], references: [id])

  @@index([centerId])
  @@map("center_admin_profiles")
}

model Center {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId         String?      @map("owner_user_id") @db.Uuid // NULL for shadow centers
  name                String
  shortId             String       @unique @map("short_id")
  description         String?
  address             String?
  area                String?
  subjects            String[]
  lat                 Float?
  lng                 Float?
  phone               String?
  whatsapp            String?
  email               String?
  logoUrl             String?      @map("logo_url")
  classroomCount      Int          @default(0) @map("classroom_count")
  entityType          EntityType   @default(registered) @map("entity_type")
  status              CenterStatus @default(pending)
  walletBalance       Int          @default(0) @map("wallet_balance") // piasters; DB CHECK (>= 0) NOT VALID, H2
  receiptSeq          Int          @default(0) @map("receipt_seq")
  governorate         String? // المحافظة (onboarding §6; `area` stays المنطقة)
  onboardingCompleted Boolean      @default(false) @map("onboarding_completed")
  onboardingDraft     Json?        @map("onboarding_draft") // wizard auto-save (§9)
  // Demo/seed data marker — see User.isDemo.
  isDemo              Boolean      @default(false) @map("is_demo")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  admins       CenterAdminProfile[]
  rooms        Room[]
  courses      Course[]
  centerStages CenterStage[]

  @@index([status])
  @@index([area])
  @@map("centers")
}

// =============================================================================
// TOKENS / AUTH
// =============================================================================

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_tokens")
}

model InviteToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable since Step 7: walk_in_onboarding tokens key on userId (phone-only
  // shell students have no email); the email-based purposes still set it.
  email     String?
  userId    String?       @map("user_id") @db.Uuid
  tokenHash String        @unique @map("token_hash")
  purpose   InvitePurpose
  centerId  String?       @map("center_id") @db.Uuid
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@index([userId])
  @@index([centerId])
  @@map("invite_tokens")
}

enum WhatsAppMessageStatus {
  queued
  sent
  failed

  @@map("whatsapp_message_status")
}

enum WhatsAppProvider {
  mock
  cloud_api

  @@map("whatsapp_provider")
}

// Step 7: WhatsApp send-attempt log (every attempt, mock included). App-layer
// scoped like payment_intents — not in the tenant_isolation RLS set.
model WhatsAppMessage {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientPhone    String                @map("recipient_phone")
  template          String
  params            Json?
  locale            String                @default("ar")
  status            WhatsAppMessageStatus @default(queued)
  provider          WhatsAppProvider
  providerMessageId String?               @map("provider_message_id")
  providerResponse  Json?                 @map("provider_response")
  error             String?
  userId            String?               @map("user_id") @db.Uuid
  centerId          String?               @map("center_id") @db.Uuid
  createdBy         String?               @map("created_by") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([recipientPhone, createdAt(sort: Desc)])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("whatsapp_messages")
}

model UserDeviceToken {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("user_device_tokens")
}

// Native Web Push (VAPID) subscriptions for the PWA — distinct from
// UserDeviceToken because a PushSubscription is a 3-part {endpoint, p256dh,
// auth} object, not a single opaque token like an FCM registration id.
model WebPushSubscription {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model UserPrefs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  tourCompleted Boolean  @default(false) @map("tour_completed")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("user_prefs")
}

// =============================================================================
// TENANT ROSTER & AFFILIATION
// =============================================================================

model CenterStudentRoster {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId               String    @map("center_id") @db.Uuid
  studentId              String    @map("student_id") @db.Uuid
  operationalParentName  String?   @map("operational_parent_name")
  operationalParentPhone String?   @map("operational_parent_phone")
  addedAt                DateTime  @default(now()) @map("added_at") @db.Timestamptz(6)
  leftAt                 DateTime? @map("left_at") @db.Timestamptz(6)
  blacklisted            Boolean   @default(false)
  blacklistReason        String?   @map("blacklist_reason")
  blacklistedAt          DateTime? @map("blacklisted_at") @db.Timestamptz(6)
  blacklistedBy          String?   @map("blacklisted_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([centerId, studentId])
  @@index([studentId])
  @@map("center_student_rosters")
}

model CenterTeacherAffiliation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId    String            @map("center_id") @db.Uuid
  teacherId   String            @map("teacher_id") @db.Uuid
  status      AffiliationStatus @default(pending)
  centerShare Int?              @map("center_share") // piasters — agreed teacher/center split
  invitedAt   DateTime          @default(now()) @map("invited_at") @db.Timestamptz(6)
  respondedAt DateTime?         @map("responded_at") @db.Timestamptz(6)
  removedAt   DateTime?         @map("removed_at") @db.Timestamptz(6)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([centerId])
  @@index([teacherId])
  @@index([centerId, teacherId])
  @@map("center_teacher_affiliations")
}

// Teacher's team: assistants are the primary messaging contact point for the
// teacher's students/parents (the teacher only handles escalations). One row
// per teacher↔assistant pair; `removedAt` soft-revokes membership.
model TeacherAssistant {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId   String    @map("teacher_id") @db.Uuid // users.id (role=teacher)
  assistantId String    @map("assistant_id") @db.Uuid // users.id (role=assistant)
  title       String? // e.g. "Grading assistant", shown in chat directory
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([teacherId, assistantId])
  // Plus (Step 8, raw SQL — Prisma can't express partial uniques): UNIQUE on
  // assistant_id WHERE removed_at IS NULL — one active teacher per assistant.
  @@index([assistantId])
  @@map("teacher_assistants")
}

// Center staff (receptionist / manager / center-accountant). Mirrors
// TeacherAssistant: a center may have MANY staff; delegation is DEFAULT-CLOSED
// (see apps/www/src/lib/authz/center-actor.ts); every staff member acts ON
// BEHALF OF the center and is audited as such. A staff member serves EXACTLY
// ONE center (raw-SQL partial unique on staff_user_id WHERE removed_at IS NULL).
// Unlike CenterAdminProfile (a co-equal center_admin owner), staff are a
// separate, lower-privilege role. No isDemo column — inherits by ancestry from
// the flagged root User/Center (decision #6). HAS a center_id, so unlike
// teacher_assistants it IS DB-tenant-isolated via RLS.
model CenterStaff {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId    String          @map("center_id") @db.Uuid // centers.id
  staffUserId String          @map("staff_user_id") @db.Uuid // users.id (role=center_staff)
  role        CenterStaffRole @default(receptionist)
  title       String? // free-text label, shown in the staff directory
  removedAt   DateTime?       @map("removed_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([centerId, staffUserId])
  // Plus (raw SQL — Prisma can't express partial uniques): UNIQUE on
  // staff_user_id WHERE removed_at IS NULL — one ACTIVE center per staff user.
  @@index([staffUserId])
  @@index([centerId])
  @@map("center_staff")
}

enum TeamNoteStatus {
  open
  done
  declined

  @@map("team_note_status")
}

// Team notes — a lightweight internal TO-DO board for exactly ONE team:
// a center's team (centerId set: owner/center_admins + active center_staff)
// XOR a teacher's team (teacherId set: teacher + active assistants). Raw-SQL
// CHECK team_notes_exactly_one_scope enforces the XOR. Deliberately NOT
// messaging: the chat matrix has no staff↔staff / assistant↔assistant edge
// and stays untouched — a note is non-conversational (status + read receipts).
// Center rows are RLS tenant-isolated like center_staff; teacher rows have a
// NULL center_id and are app-guarded like teacher_assistants.
model TeamNote {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId          String?        @map("center_id") @db.Uuid // centers.id (center team board)
  teacherId         String?        @map("teacher_id") @db.Uuid // users.id role=teacher (teacher team board)
  authorUserId      String         @map("author_user_id") @db.Uuid // author writes as THEMSELVES (no impersonation)
  body              String
  pinned            Boolean        @default(false)
  status            TeamNoteStatus @default(open)
  statusChangedById String?        @map("status_changed_by_id") @db.Uuid
  statusChangedAt   DateTime?      @map("status_changed_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6) // soft-delete (convention)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  reads TeamNoteRead[]

  @@index([centerId, createdAt(sort: Desc)])
  @@index([teacherId, createdAt(sort: Desc)])
  @@map("team_notes")
}

// Read receipts: one row per team member who has SEEN a note (upserted when
// the board is opened). Powers the "who read this" line on each note. No
// center_id — a receipt is only ever reached through its already-authorized
// note, so like teacher_assistants it is app-guarded, not DB-tenant-isolated.
model TeamNoteRead {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noteId String   @map("note_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  readAt DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  note TeamNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@map("team_note_reads")
}

model ParentStudentLink {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String           @map("parent_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  status      ParentLinkStatus @default(pending)
  initiatedBy LinkActor        @map("initiated_by")
  revokedBy   LinkActor?       @map("revoked_by")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([studentId])
  @@map("parent_student_links")
}

// =============================================================================
// ACADEMIC CORE  (Course → Session ≈ PRD "lesson"; Enrollment; Room = classroom)
// =============================================================================

// Which center-share calculation methods a room offers (Room Pricing Methods).
// whole_room_percent    = Method 1: fixed 3-way % split, frozen on the course,
//                         settled at session completion (the existing engine).
// per_attending_student = Method 2: superadmin-set rate × ACTUAL attendees,
//                         settled per session at completion through the same
//                         ledger. No price shown to the teacher at booking.
enum RoomPricingMethod {
  whole_room_percent
  per_attending_student

  @@map("room_pricing_method")
}

model Room {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId   String   @map("center_id") @db.Uuid
  name       String
  capacity   Int?
  facilities String[]
  photos     String[]
  // Room profile (center-managed). price = the center's hall price shown to
  // teachers when booking (piasters). It is NOT the revenue split — the split
  // (platform/teacher/center %) is superadmin-controlled (commission_settings).
  price       Int?
  description String?
  // Which pricing methods this room offers (center-set AVAILABILITY only — the
  // numbers behind each method stay superadmin-only). One value = forced; two
  // values = the teacher chooses at booking. DB CHECK rooms_methods_nonempty.
  allowedPricingMethods RoomPricingMethod[] @default([whole_room_percent]) @map("allowed_pricing_methods")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  center   Center    @relation(fields: [centerId], references: [id])
  courses  Course[]
  sessions Session[]

  @@index([centerId])
  @@map("rooms")
}

model Course {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId      String?      @map("center_id") @db.Uuid // NULL = teacher-owned (teacher-direct, NO shadow centers)
  teacherId     String       @map("teacher_id") @db.Uuid
  defaultRoomId String?      @map("default_room_id") @db.Uuid
  title         String
  subject       String // DEPRECATED free text — superseded by subjectId (education catalog)
  description   String?
  gradeTag      String?      @map("grade_tag") // DEPRECATED free text — superseded by gradeLevelId
  // ---- Education catalog linkage: what makes "students see only their
  // grade/track content" queryable. trackId NULL = open to all tracks.
  subjectId     String?      @map("subject_id") @db.Uuid
  gradeLevelId  String?      @map("grade_level_id") @db.Uuid
  trackId       String?      @map("track_id") @db.Uuid
  daysOfWeek    Int[]        @map("days_of_week")
  startTime     String       @map("start_time")
  endTime       String       @map("end_time")
  startDate     DateTime     @map("start_date") @db.Timestamptz(6)
  endDate       DateTime?    @map("end_date") @db.Timestamptz(6)
  price         Int // piasters — legacy full-course price (pre-subscriptions)
  // Subscription plan pricing (piasters). NULL = plan disabled for this course;
  // "at least one enabled" is enforced at the subscribe API, not by CHECK
  // (legacy courses may have neither until the owner configures plans).
  pricePerMonth   Int?       @map("price_per_month")
  pricePerSession Int?       @map("price_per_session")
  // Revenue-split SNAPSHOT — frozen at course creation for ROOM-BASED courses
  // (has a room). M4.5: settle at the split in effect at creation, never
  // retroactively re-rated when superadmin changes the config later. NULL on
  // no-room / teacher-direct courses (those use the Step 4.5 commission model).
  // All three set + sum to 10000 when present (DB CHECK course_split_shape).
  splitPlatformBp Int?       @map("split_platform_bp")
  splitTeacherBp  Int?       @map("split_teacher_bp")
  splitCenterBp   Int?       @map("split_center_bp")
  // Room pricing method SNAPSHOT (frozen at creation, like the split above —
  // M4.5: config changes never re-rate an existing course). NULL = legacy /
  // no-room / teacher-direct. whole_room_percent → the three split bps above.
  // per_attending_student → splitPlatformBp = the platform's % cut and EXACTLY
  // one of m2CenterFee (flat piasters per attending student) / m2CenterBp
  // (bp of perSessionPrice per attending student); teacher gets the remainder.
  // Shape enforced by DB CHECK course_pricing_shape.
  pricingMethod   RoomPricingMethod? @map("pricing_method")
  m2CenterFee     Int?       @map("m2_center_fee")
  m2CenterBp      Int?       @map("m2_center_bp")
  location        String? // teacher-direct free-text venue ("own hall", "Online", ...)
  maxStudents   Int          @map("max_students")
  status        CourseStatus @default(active)
  // Demo/seed data marker — see User.isDemo.
  isDemo        Boolean      @default(false) @map("is_demo")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  center        Center?      @relation(fields: [centerId], references: [id])
  room          Room?        @relation(fields: [defaultRoomId], references: [id])
  subjectRef    Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeLevelRef GradeLevel?  @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  trackRef      Track?       @relation(fields: [trackId], references: [id], onDelete: Restrict)
  sessions      Session[]
  enrollments   Enrollment[]

  @@index([centerId])
  @@index([teacherId])
  @@index([subject])
  @@index([status])
  @@index([gradeLevelId, trackId]) // student content-matching hot path
  @@index([subjectId])
  @@map("courses")
}

model Session {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId           String        @map("course_id") @db.Uuid
  teacherId          String        @map("teacher_id") @db.Uuid
  roomId             String?       @map("room_id") @db.Uuid
  originalDate       DateTime      @map("original_date") @db.Timestamptz(6)
  date               DateTime      @db.Timestamptz(6)
  startTime          String        @map("start_time")
  endTime            String        @map("end_time")
  status             SessionStatus @default(scheduled)
  cancellationReason String?       @map("cancellation_reason")
  postponedFromDate  DateTime?     @map("postponed_from_date") @db.Timestamptz(6)
  editedAt           DateTime?     @map("edited_at") @db.Timestamptz(6)
  // Set once revenue distribution has run for this session. Guards against
  // double-distribution under concurrency (see finance/distribution.ts).
  distributedAt      DateTime?     @map("distributed_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  course     Course             @relation(fields: [courseId], references: [id])
  room       Room?              @relation(fields: [roomId], references: [id])
  attendance AttendanceRecord[]

  @@index([courseId, date])
  @@index([teacherId, date])
  @@index([roomId, date])
  @@map("sessions")
}

model Enrollment {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  courseId     String           @map("course_id") @db.Uuid
  centerId     String?          @map("center_id") @db.Uuid // NULL for teacher-direct courses
  status       EnrollmentStatus @default(active)
  enrolledAt   DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  unenrolledAt DateTime?        @map("unenrolled_at") @db.Timestamptz(6)
  enrolledBy   String           @map("enrolled_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id])

  @@index([studentId])
  @@index([courseId])
  @@index([centerId])
  @@map("enrollments")
}

model EnrollmentRequest {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String                  @map("student_id") @db.Uuid
  courseId      String                  @map("course_id") @db.Uuid
  centerId      String                  @map("center_id") @db.Uuid
  status        EnrollmentRequestStatus @default(pending)
  submittedAt   DateTime                @default(now()) @map("submitted_at") @db.Timestamptz(6)
  respondedAt   DateTime?               @map("responded_at") @db.Timestamptz(6)
  respondedBy   String?                 @map("responded_by") @db.Uuid
  declineReason String?                 @map("decline_reason")
  expiresAt     DateTime                @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([studentId])
  @@index([courseId])
  @@index([centerId])
  @@map("enrollment_requests")
}

model AttendanceRecord {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String           @map("session_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  centerId       String?          @map("center_id") @db.Uuid // NULL for teacher-direct courses
  status         AttendanceStatus
  markedBy       String           @map("marked_by") @db.Uuid
  // Step 6 check-in stages — facts; `status` is the derived truth.
  counterAt      DateTime?        @map("counter_at") @db.Timestamptz(6)
  counterBy      String?          @map("counter_by") @db.Uuid // front-desk staff
  doorAt         DateTime?        @map("door_at") @db.Timestamptz(6)
  doorBy         String?          @map("door_by") @db.Uuid // assistant (teacher fallback)
  editedAt       DateTime?        @map("edited_at") @db.Timestamptz(6)
  synced         Boolean          @default(true) // false = captured offline, not yet synced (PRD)
  localTimestamp DateTime?        @map("local_timestamp") @db.Timestamptz(6) // device time when marked offline
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([courseId])
  @@index([centerId])
  @@map("attendance_records")
}

model Grade {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String    @map("course_id") @db.Uuid
  centerId  String    @map("center_id") @db.Uuid
  teacherId String    @map("teacher_id") @db.Uuid
  name      String
  gradeType GradeType @default(numeric) @map("grade_type")
  maxScore  Int       @map("max_score")
  date      DateTime  @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  scores GradeScore[]

  @@index([courseId])
  @@index([centerId])
  @@map("grades")
}

// Was an embedded array on Grade in Mongo; normalized to its own table.
model GradeScore {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gradeId   String @map("grade_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  score     Float

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, studentId])
  @@index([studentId])
  @@map("grade_scores")
}

model Material {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId           String          @map("course_id") @db.Uuid
  centerId           String          @map("center_id") @db.Uuid
  teacherId          String          @map("teacher_id") @db.Uuid
  title              String
  type               MaterialType
  storageProvider    MaterialStorage @default(cloudinary) @map("storage_provider")
  cloudinaryPublicId String?         @map("cloudinary_public_id")
  cloudinaryUrl      String?         @map("cloudinary_url")
  externalUrl        String?         @map("external_url")
  fileSizeBytes      Int?            @map("file_size_bytes")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([courseId])
  @@index([centerId])
  @@map("materials")
}

// PRD classroom_bookings: teacher requests a Room for a Session; center approves
// with an agreed center_share. This is the hook the fee/distribution engine reads.

// =============================================================================
// MONEY  (existing Payment/Expense preserved; PRD ledger added below)
// =============================================================================

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId      String?       @map("center_id") @db.Uuid // NULL for teacher-direct receipts (platform_receipt_seq)
  studentId     String        @map("student_id") @db.Uuid
  // Who actually PAID, when that is not the student themselves (a parent paying
  // for their child). NULL = the student paid for themselves, which is what
  // every row predating the parent wallet means.
  payerUserId   String?       @map("payer_user_id") @db.Uuid
  courseId      String?       @map("course_id") @db.Uuid
  status        PaymentStatus @default(paid)
  amount        Int // piasters, SIGNED (positive=payment, negative=refund)
  currency      String        @default("EGP")
  note          String?
  receiptNumber String        @unique @map("receipt_number")
  recordedBy    String        @map("recorded_by") @db.Uuid
  paidAt        DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([centerId, paidAt(sort: Desc)])
  @@index([studentId, paidAt(sort: Desc)])
  @@index([payerUserId])
  @@map("payments")
}

model Expense {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId    String          @map("center_id") @db.Uuid
  amount      Int // piasters (positive)
  currency    String          @default("EGP")
  category    ExpenseCategory
  description String?
  recordedBy  String          @map("recorded_by") @db.Uuid
  expenseDate DateTime        @map("expense_date") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([centerId, expenseDate(sort: Desc)])
  @@map("expenses")
}

// PRD §3.3 immutable ledger — append-only, corrections via reversal entries.
model Transaction {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refNumber     String            @unique @map("ref_number") // TXN-2026-XXXXX
  type          TransactionType
  amount        Int // piasters
  fromEntityId  String?           @map("from_entity_id") @db.Uuid
  toEntityId    String?           @map("to_entity_id") @db.Uuid
  centerId      String?           @map("center_id") @db.Uuid
  lessonId      String?           @map("lesson_id") @db.Uuid // -> sessions.id
  status        TransactionStatus @default(pending)
  paymentMethod PaymentMethod?    @map("payment_method")
  gatewayRef    String?           @map("gateway_ref")
  reversalOfId  String?           @map("reversal_of_id") @db.Uuid // correction linkage
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([centerId])
  @@index([type])
  @@index([status])
  @@index([lessonId])
  @@index([fromEntityId])
  @@index([toEntityId])
  // Hot path: accountant ledger filtered by type+status, newest first.
  @@index([type, status, createdAt(sort: Desc)])
  // Plus (H3, raw SQL — Prisma can't express partial uniques): UNIQUE on
  // reversal_of_id WHERE type='refund' — a charge is refunded at most once.
  @@map("transactions")
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number") // INV-2026-XXXXX
  type          InvoiceType
  centerId      String?       @map("center_id") @db.Uuid
  issuedToId    String?       @map("issued_to_id") @db.Uuid
  periodStart   DateTime?     @map("period_start") @db.Date
  periodEnd     DateTime?     @map("period_end") @db.Date
  subtotal      Int? // piasters
  commission    Int? // piasters
  netAmount     Int?          @map("net_amount") // piasters
  status        InvoiceStatus @default(issued)
  pdfUrl        String?       @map("pdf_url")
  qrCode        String?       @map("qr_code")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([centerId])
  @@index([type])
  @@index([issuedToId])
  @@index([createdAt(sort: Desc)])
  @@map("invoices")
}

model Payout {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId        String?         @map("center_id") @db.Uuid
  beneficiaryId   String          @map("beneficiary_id") @db.Uuid
  beneficiaryType BeneficiaryType @map("beneficiary_type")
  periodStart     DateTime?       @map("period_start") @db.Date
  periodEnd       DateTime?       @map("period_end") @db.Date
  lessonCount     Int?            @map("lesson_count")
  grossAmount     Int?            @map("gross_amount") // piasters
  commission      Int? // piasters
  netPayable      Int?            @map("net_payable") // piasters
