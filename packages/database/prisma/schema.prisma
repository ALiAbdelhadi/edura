// Teacher's team: assistants are the primary messaging contact point for the
// teacher's students/parents (the teacher only handles escalations). One row
// per teacher↔assistant pair; `removedAt` soft-revokes membership.
model TeacherAssistant {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId   String    @map("teacher_id") @db.Uuid // users.id (role=teacher)
  assistantId String    @map("assistant_id") @db.Uuid // users.id (role=assistant)
  title       String? // e.g. "Grading assistant", shown in chat directory
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([teacherId, assistantId])
  // Plus (Step 8, raw SQL — Prisma can't express partial uniques): UNIQUE on
  // assistant_id WHERE removed_at IS NULL — one active teacher per assistant.
  @@index([assistantId])
  @@map("teacher_assistants")
}

// Center staff (receptionist / manager / center-accountant). Mirrors
// TeacherAssistant: a center may have MANY staff; delegation is DEFAULT-CLOSED
// (see apps/www/src/lib/authz/center-actor.ts); every staff member acts ON
// BEHALF OF the center and is audited as such. A staff member serves EXACTLY
// ONE center (raw-SQL partial unique on staff_user_id WHERE removed_at IS NULL).
// Unlike CenterAdminProfile (a co-equal center_admin owner), staff are a
// separate, lower-privilege role. No isDemo column — inherits by ancestry from
// the flagged root User/Center (decision #6). HAS a center_id, so unlike
// teacher_assistants it IS DB-tenant-isolated via RLS.
model CenterStaff {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId    String          @map("center_id") @db.Uuid // centers.id
  staffUserId String          @map("staff_user_id") @db.Uuid // users.id (role=center_staff)
  role        CenterStaffRole @default(receptionist)
  title       String? // free-text label, shown in the staff directory
  removedAt   DateTime?       @map("removed_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([centerId, staffUserId])
  // Plus (raw SQL — Prisma can't express partial uniques): UNIQUE on
  // staff_user_id WHERE removed_at IS NULL — one ACTIVE center per staff user.
  @@index([staffUserId])
  @@index([centerId])
  @@map("center_staff")
}

enum TeamNoteStatus {
  open
  done
  declined

  @@map("team_note_status")
}

// Team notes — a lightweight internal TO-DO board for exactly ONE team:
// a center's team (centerId set: owner/center_admins + active center_staff)
// XOR a teacher's team (teacherId set: teacher + active assistants). Raw-SQL
// CHECK team_notes_exactly_one_scope enforces the XOR. Deliberately NOT
// messaging: the chat matrix has no staff↔staff / assistant↔assistant edge
// and stays untouched — a note is non-conversational (status + read receipts).
// Center rows are RLS tenant-isolated like center_staff; teacher rows have a
// NULL center_id and are app-guarded like teacher_assistants.
model TeamNote {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId          String?        @map("center_id") @db.Uuid // centers.id (center team board)
  teacherId         String?        @map("teacher_id") @db.Uuid // users.id role=teacher (teacher team board)
  authorUserId      String         @map("author_user_id") @db.Uuid // author writes as THEMSELVES (no impersonation)
  body              String
  pinned            Boolean        @default(false)
  status            TeamNoteStatus @default(open)
  statusChangedById String?        @map("status_changed_by_id") @db.Uuid
  statusChangedAt   DateTime?      @map("status_changed_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6) // soft-delete (convention)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  reads TeamNoteRead[]

  @@index([centerId, createdAt(sort: Desc)])
  @@index([teacherId, createdAt(sort: Desc)])
  @@map("team_notes")
}

// Read receipts: one row per team member who has SEEN a note (upserted when
// the board is opened). Powers the "who read this" line on each note. No
// center_id — a receipt is only ever reached through its already-authorized
// note, so like teacher_assistants it is app-guarded, not DB-tenant-isolated.
model TeamNoteRead {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noteId String   @map("note_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  readAt DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  note TeamNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@map("team_note_reads")
}

model ParentStudentLink {
