  @@index([centerId, expenseDate(sort: Desc)])
  @@map("expenses")
}

// PRD §3.3 immutable ledger — append-only, corrections via reversal entries.
model Transaction {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refNumber     String            @unique @map("ref_number") // TXN-2026-XXXXX
  type          TransactionType
  amount        Int // piasters
  fromEntityId  String?           @map("from_entity_id") @db.Uuid
  toEntityId    String?           @map("to_entity_id") @db.Uuid
  centerId      String?           @map("center_id") @db.Uuid
  lessonId      String?           @map("lesson_id") @db.Uuid // -> sessions.id
  status        TransactionStatus @default(pending)
  paymentMethod PaymentMethod?    @map("payment_method")
  gatewayRef    String?           @map("gateway_ref")
  reversalOfId  String?           @map("reversal_of_id") @db.Uuid // correction linkage
  notes         String?
  // Provenance (see DataSource). Set at INSERT only — this table is append-only
  // (REVOKE UPDATE/DELETE + the runtime immutability extension), so the label
  // can never be rewritten after the fact. It exists so a center's finance
  // reports can separate money the platform collected from money its staff keyed
  // in for an off-system teacher, WITHOUT joining back through course->teacher.
  dataSource    DataSource        @default(system) @map("data_source")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([centerId])
  @@index([type])
  @@index([status])
  @@index([lessonId])
  @@index([fromEntityId])
  @@index([toEntityId])
  // Hot path: accountant ledger filtered by type+status, newest first.
  @@index([type, status, createdAt(sort: Desc)])
  // Plus (H3, raw SQL — Prisma can't express partial uniques): UNIQUE on
  // reversal_of_id WHERE type='refund' — a charge is refunded at most once.
  @@map("transactions")
}

