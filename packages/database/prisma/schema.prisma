// =============================================================================
// NOTIFICATIONS / BLACKLIST / AUDIT
// =============================================================================

model Notification {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  type         NotificationType
  title        String
  body         String
  data         Json               @default("{}")
  channels     String[]           @default([]) // ['fcm','email','sms']
  status       NotificationStatus @default(pending)
  fcmMessageId String?            @map("fcm_message_id")
  read         Boolean            @default(false)
  readAt       DateTime?          @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([read])
  @@map("notifications")
}

model BlacklistEntry {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetId    String         @map("target_id") @db.Uuid
  level       BlacklistLevel
  centerId    String?        @map("center_id") @db.Uuid // scope for center/teacher levels
  imposedById String         @map("imposed_by_id") @db.Uuid
  reason      String
  isActive    Boolean        @default(true) @map("is_active")
  removedAt   DateTime?      @map("removed_at") @db.Timestamptz(6)
  removedBy   String?        @map("removed_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetId])
  @@index([centerId])
  @@index([level])
  @@map("blacklist_entries")
}

/// H-04 — the record of what a blacklist actually DID, so lifting it can give
/// back exactly that and nothing else. One append-only row per entity removed
/// by a blacklist, keyed to the BlacklistEntry that removed it; the lift stamps
/// `reversedAt` + `reversal` on each. Never matched by timestamp: a blacklist
/// can be applied and lifted repeatedly, and each entry owns its own rows.
/// Roster bookkeeping only — nothing here touches the money ledger.
model BlacklistCascadeAction {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId    String    @map("entry_id") @db.Uuid // BlacklistEntry that caused the removal
  targetId   String    @map("target_id") @db.Uuid
  entityType String    @map("entity_type") // 'enrollment' — the seam for future cascades
  entityId   String    @map("entity_id") @db.Uuid
  centerId   String?   @map("center_id") @db.Uuid // scope snapshot; NULL = teacher-direct course
  courseId   String    @map("course_id") @db.Uuid
  prevStatus String    @map("prev_status")
  appliedAt  DateTime  @default(now()) @map("applied_at") @db.Timestamptz(6)
  // NULL while outstanding — a lift only ever considers those, which is what
  // makes reversal idempotent and blacklist→lift→blacklist cycles independent.
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)
  reversal   String? // restored | restored_over_capacity | skipped_* (DB CHECK)
  reversedBy String?   @map("reversed_by") @db.Uuid

  @@unique([entryId, entityType, entityId])
  @@index([targetId, appliedAt(sort: Desc)])
  @@map("blacklist_cascade_actions")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String // e.g. 'center.approved', 'blacklist.added'
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  centerId    String?  @map("center_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  // Step 8: set when an assistant acted for their teacher (actorId = assistant).
  onBehalfOf  String?  @map("on_behalf_of") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([centerId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// =============================================================================
// DELETION REQUESTS (existing)
// =============================================================================

// ONE deletion queue, three origins. This table was born as the CENTER-raised
// queue; the data-rights work (قانون 151/2020) added the SELF- and
// GUARDIAN-raised paths to the SAME table rather than opening a second way to
// disable an account. Approving is a soft delete + a PII scrub — the money
// ledger is never touched (see the 20260802100100 migration header).
model DeletionRequest {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  centerId      String?        @map("center_id") @db.Uuid
  reason        String
  status        DeletionStatus @default(pending)
  // Who raised it. NULL only on rows predating the column — all center-raised.
  requestedBy   String?        @map("requested_by") @db.Uuid
  origin        DeletionOrigin @default(center)
  requesterNote String?        @map("requester_note")
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)
  reviewedBy    String?        @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewNote    String?        @map("review_note")
  // NULL on an approved row = soft-deleted but still carrying a name. The
  // admin queue surfaces that state so a half-finished erasure cannot hide.
  anonymizedAt  DateTime?      @map("anonymized_at") @db.Timestamptz(6)
  anonymizedBy  String?        @map("anonymized_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([centerId, status])
  @@index([status, requestedAt(sort: Desc)])
  // Plus (raw SQL — Prisma cannot express a partial unique): UNIQUE on
  // user_id WHERE status = 'pending'. One open request per subject.
  @@map("deletion_requests")
}

// =============================================================================
// MATURITY LAYER — feature flags, contact inbox, data exports (2026-08-02)
// =============================================================================

// Platform-global feature switches. DEFAULT-CLOSED: a key with no row here
// reads as disabled, so a typo or an unseeded database fails to "off".
model FeatureFlag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  note        String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

// `model ContactSubmission` is NOT here. The conversion layer landed the same
// table independently (migration 20260802140000_contact_submissions, written
// IF NOT EXISTS against the shape this branch had already applied to dev), and
// its model is the one that survives — see the bottom of this file. Two models
// mapping to `contact_submissions` would not compile, and the duplicate
// deleted here was the younger of two identical definitions.
//
// The back-office READER for those rows is
// apps/superadmin/src/lib/services/admin/contact-submissions.ts, in this
// branch; the WRITER is apps/www POST /api/v1/contact, in theirs.

// Self-serve data export. The payload lives INLINE and expires — there is no
// file in object storage and therefore no public URL to leak.
model DataExportRequest {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  // Equals userId for a self-serve request; a parent's id when a guardian
  // exports a minor child's data.
  requestedBy String           @map("requested_by") @db.Uuid
  status      DataExportStatus @default(pending)
  requestedAt DateTime         @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt   DateTime?        @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(6)
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz(6)
  payload     Json?
  byteSize    Int?             @map("byte_size")
  error       String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)])
  @@index([status, requestedAt])
  // Plus (raw SQL): UNIQUE on user_id WHERE status IN ('pending','processing').
  @@map("data_export_requests")
}

// =============================================================================
// MESSAGING / REVIEWS
// =============================================================================

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  centerId  String?  @map("center_id") @db.Uuid
  lessonId  String?  @map("lesson_id") @db.Uuid // -> sessions.id, for per-lesson ratings (PRD)
  rating    Int // 1..5 (enforced at API layer + CHECK constraint in migration)
  text      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // UNIQUENESS LIVES IN TWO PARTIAL INDEXES, NOT HERE — Prisma cannot express
  // a `WHERE` on a unique index, so they are created in the migration
  // 20260818120000_review_per_lesson_unique and are invisible to this model:
  //   reviews_one_overall_per_teacher  UNIQUE (student_id, teacher_id) WHERE lesson_id IS NULL
  //   reviews_one_per_lesson           UNIQUE (student_id, lesson_id)  WHERE lesson_id IS NOT NULL
  // The plain @@unique([studentId, teacherId]) that used to stand here made
  // `lessonId` — documented on the column as "for per-lesson ratings" —
  // impossible to use: the second lesson a student rated collided with the
  // first. A three-column unique was rejected because NULLs are distinct in
  // Postgres, which would have allowed unlimited overall reviews.
  // Same pattern as commission_one_per_center and the one-refund-per-payment
  // guard. Application-level duplicate checks live in services/reviews.
  @@index([teacherId])
  @@index([centerId])
  @@index([lessonId])
  @@map("reviews")
}

// =============================================================================
// REAL-TIME CHAT (1:1 conversations only — exactly two participants)
//
// The pair is stored canonically (user_a_id < user_b_id, enforced by a CHECK
// constraint in the migration) so one unique index guarantees a single
// conversation per pair. Per-side unread counters / read cursors live on the
// conversation row; per-message delivery state lives on the message.
// Who may talk to whom is enforced by src/queries/chat-scope.ts (the single
// source of truth: the EDGES relationship table) gated by chat-policy.ts (the
// role-pair matrix), NOT here.
// =============================================================================

enum MessageDeliveryStatus {
  sent // persisted, recipient not yet reached
  delivered // recipient's client received it (socket ack / delivered-on-connect sweep)
  read // recipient opened the conversation past this message

  @@map("message_delivery_status")
}

model Conversation {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Canonical pair: user_a_id < user_b_id (CHECK constraint in migration).
  userAId  String  @map("user_a_id") @db.Uuid
  userBId  String  @map("user_b_id") @db.Uuid
  // Tenant context when either side belongs to a center (RLS defense-in-depth).
  centerId String? @map("center_id") @db.Uuid

  // Denormalized list-view state.
  lastMessageAt       DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview  String?  @map("last_message_preview")
  lastMessageSenderId String?  @map("last_message_sender_id") @db.Uuid

  // Per-side unread counters + read cursors (a = userA's state, b = userB's).
  aUnreadCount Int       @default(0) @map("a_unread_count")
  bUnreadCount Int       @default(0) @map("b_unread_count")
  aLastReadAt  DateTime? @map("a_last_read_at") @db.Timestamptz(6)
  bLastReadAt  DateTime? @map("b_last_read_at") @db.Timestamptz(6)

  // Belt-and-braces on top of ancestry inheritance (decision #6): conversations
  // are children of flagged demo users, but an explicit flag makes the
  // pre-launch purge a single DELETE instead of a join over both participants.
  isDemo Boolean @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages ConversationMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt(sort: Desc)])
  @@index([userBId, lastMessageAt(sort: Desc)])
  @@index([centerId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMessage {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String  @map("conversation_id") @db.Uuid
  senderId       String  @map("sender_id") @db.Uuid
  // Monotonic insertion order (bigserial) — the authoritative sort key.
  // Wall-clock timestamps are for display only; seq survives clock skew.
  seq            BigInt  @default(autoincrement())
  body           String
  // Client-generated idempotency key: retries after reconnect can't duplicate.
  clientId       String? @map("client_id")

  status      MessageDeliveryStatus @default(sent)
  deliveredAt DateTime?             @map("delivered_at") @db.Timestamptz(6)
  readAt      DateTime?             @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  // Child-safety retention: soft-delete ONLY. The body is never erased — a
  // removed message renders as "message removed" to participants while staying
  // fully readable in the super-admin log. There is no hard-delete path.
  deletedAt   DateTime?             @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?               @map("deleted_by") @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientId])
  @@index([conversationId, seq])
  // Delivered-on-connect sweep: find a recipient's undelivered messages fast.
  @@index([conversationId, status])
  @@map("conversation_messages")
}

// =============================================================================
// GROUP CONVERSATIONS
// -----------------------------------------------------------------------------
// Announcement-style channels whose membership is DERIVED from real platform
// relationships — never an arbitrary hand-picked list:
//   course              → the course's active enrollments (+ teacher, the
//                         teacher's active assistants, the center's staff, and
//                         the enrolled students' approved parents)
//   session             → the students whose coverage includes that session
//   center_announcement → the center's roster ∪ its active enrollments
//
// `GroupMember` is a CACHE for fanout/listing only. Authorization ALWAYS
// re-derives live for the single user being checked (chat-scope.ts
// assertGroupAccess), so a stale snapshot can never grant access: a student who
// dropped the course cannot post even if their cached row still exists.
// =============================================================================

enum GroupKind {
  course
  session
  center_announcement

  @@map("group_kind")
}

enum GroupPostPolicy {
  owner_only // default — announcements: only the owner + their delegates post
  members // open discussion among derived members

  @@map("group_post_policy")
}

model ConversationGroup {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      GroupKind
  // Exactly ONE source relation is set, matching `kind` (DB CHECK
  // conversation_groups_source_shape). This is what membership derives from.
  courseId  String?   @map("course_id") @db.Uuid
  // Scoped to one session of `courseId` when kind=session.
  sessionId String?   @map("session_id") @db.Uuid
  centerId  String?   @map("center_id") @db.Uuid

  // The principal that owns the channel: the course teacher, or a center admin
  // for center_announcement. Delegates (the teacher's assistants / the center's
  // manager staff) post through the owner's derived rights, as themselves.
  ownerId    String          @map("owner_id") @db.Uuid
  title      String
  postPolicy GroupPostPolicy @default(owner_only) @map("post_policy")

  lastMessageAt       DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview  String?  @map("last_message_preview")
  lastMessageSenderId String?  @map("last_message_sender_id") @db.Uuid

  isDemo     Boolean   @default(false) @map("is_demo")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  members  GroupMember[]
  messages GroupMessage[]

  // One channel per source relation (partial uniques in the migration, since
  // the source column differs per kind).
  @@index([ownerId, lastMessageAt(sort: Desc)])
  @@index([centerId, lastMessageAt(sort: Desc)])
  @@index([courseId])
  @@index([sessionId])
  @@map("conversation_groups")
}

// Materialized membership snapshot — fanout + unread counters ONLY. Never the
// authorization source (see assertGroupAccess).
model GroupMember {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String    @map("group_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     Role
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(6)

  lastReadAt  DateTime? @map("last_read_at") @db.Timestamptz(6)
  unreadCount Int       @default(0) @map("unread_count")
  muted       Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group ConversationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, leftAt])
  @@map("group_members")
}

model GroupMessage {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String  @map("group_id") @db.Uuid
  senderId String  @map("sender_id") @db.Uuid
  // Same authoritative ordering key as 1:1 messages.
  seq      BigInt  @default(autoincrement())
  body     String
  clientId String? @map("client_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Soft-delete only — see ConversationMessage.deletedAt.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  group ConversationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, clientId])
  @@index([groupId, seq])
  @@map("group_messages")
}

// =============================================================================
// SAFETY: BLOCKS & REPORTS
// -----------------------------------------------------------------------------
// Both are enforced in the SAME single place as every other messaging rule
// (chat-scope.ts assertCanReach), so no entry point can bypass them.
// =============================================================================

enum ReportCategory {
  harassment
  spam
  inappropriate
  safety_concern // child-safety escalation — auto-prioritized
  other

  @@map("report_category")
}

enum ReportStatus {
  open
  reviewing
  actioned
  dismissed

  @@map("report_status")
}

// A block halts NEW messages in BOTH directions for the pair. History is never
// deleted, and a block never hides the conversation from parent oversight or
// from the super-admin log — an adult cannot use it to bury a thread with a
// minor. `removedAt` un-blocks (raw-SQL partial unique on the active row).
model ConversationBlock {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId      String    @map("blocker_id") @db.Uuid
  blockedId      String    @map("blocked_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(6)

  // Plus (raw SQL — Prisma can't express partial uniques): UNIQUE on
  // (blocker_id, blocked_id) WHERE removed_at IS NULL — one active block.
  @@index([blockerId, removedAt])
  @@index([blockedId, removedAt])
  @@map("conversation_blocks")
}

model ConversationReport {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String  @map("reporter_id") @db.Uuid
  reportedUserId String  @map("reported_user_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  groupId        String? @map("group_id") @db.Uuid
  messageId      String? @map("message_id") @db.Uuid

  category      ReportCategory
  details       String?
  status        ReportStatus   @default(open)
  // Set when the reporter OR the reported user is a minor at filing time —
  // drives the super-admin queue's priority sort.
  involvesMinor Boolean        @default(false) @map("involves_minor")

  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  resolutionNote String?   @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, involvesMinor, createdAt(sort: Desc)])
  @@index([reportedUserId])
  @@index([reporterId])
  @@map("conversation_reports")
}

// =============================================================================
// CHATBOT & AI  (SCHEMA ONLY — no AI logic wired, per scope §1)
// =============================================================================

model ChatbotConfig {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supportBotEnabled   Boolean   @default(true) @map("support_bot_enabled")
  academicBotEnabled  Boolean   @default(true) @map("academic_bot_enabled")
  monthlyTokenLimit   Int       @default(1000000) @map("monthly_token_limit")
  tokensUsedThisMonth Int       @default(0) @map("tokens_used_this_month")
  lastResetAt         DateTime? @map("last_reset_at") @db.Date
  updatedBy           String?   @map("updated_by") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("chatbot_config")
}

model ChatbotFaq {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question  String
  answer    String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("chatbot_faq")
}

model ChatbotConversation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  sessionId    String?  @map("session_id") @db.Uuid
  messages     Json? // [{role, content, timestamp}]
  botType      BotType? @map("bot_type")
  handedOff    Boolean  @default(false) @map("handed_off") // feeds human support queue
  handoffTo    String?  @map("handoff_to")
  satisfaction Int? // 1..5
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([handedOff])
  @@map("chatbot_conversations")
}

// =============================================================================
// EDUCATION CATALOG  (config-driven onboarding — Egyptian market)
// -----------------------------------------------------------------------------
// Platform-global lookup tables (no center_id): system → stage → grade level
// → track, subjects, and subject_offerings ("this subject is taught THERE").
// Everything is admin-managed data; wizards and matching read it — no
// hardcoded subject/track names anywhere in business logic. `code` is the
// stable seed/reference key (ids stay opaque); is_active + sort_order give
// admins soft-hide and ordering without deletes. RLS: world-readable,
// writable only under rls_bypass() (super_admin platform context) — see the
// education_catalog migration.
// "Grade level" = school year (الصف). NOT the existing `grades` table, which
// holds exam grades.
// =============================================================================

model EducationSystem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique // 'general' | 'azhari' | 'bacc' | ...
  // The letter that opens every student code in this system (G / A / B). It
  // lives on the catalog rather than in application code so a system added
  // later needs no deploy. NULLABLE: a system without a letter simply cannot
  // finalize codes yet — its students keep the pending 'X', which is a working
  // state. 'X' itself is refused by a CHECK; it means "not chosen yet".
  codeLetter String? @unique @map("code_letter") @db.Char(1)
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  iconKey   String?  @map("icon_key") // wizard card icon
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stages          Stage[]
  studentProfiles StudentProfile[]

  @@index([isActive, sortOrder])
  @@map("education_systems")
}

model Stage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  educationSystemId String   @map("education_system_id") @db.Uuid
  code              String   @unique // 'general-primary', 'azhari-secondary', ...
  nameAr            String   @map("name_ar")
  nameEn            String?  @map("name_en")
  hasSecondLanguage Boolean  @default(false) @map("has_second_language") // gates the wizard's 2nd-language step
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  system          EducationSystem  @relation(fields: [educationSystemId], references: [id])
  gradeLevels     GradeLevel[]
  tracks          Track[]
  studentProfiles StudentProfile[]
  centerStages    CenterStage[]

  @@index([educationSystemId, isActive, sortOrder])
  @@map("stages")
}

model GradeLevel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageId   String   @map("stage_id") @db.Uuid
  code      String   @unique // 'general-primary-1' ... 'bacc-secondary-3'
  nameAr    String   @map("name_ar") // "الصف الأول الابتدائي"
  nameEn    String?  @map("name_en")
  level     Int // 1..n within the stage
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stage              Stage               @relation(fields: [stageId], references: [id])
  gradeTracks        GradeLevelTrack[]
  offerings          SubjectOffering[]
  studentProfiles    StudentProfile[]
  teacherGradeLevels TeacherGradeLevel[]
  courses            Course[]

  @@index([stageId, isActive, sortOrder])
  @@map("grade_levels")
}

model Track {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageId   String   @map("stage_id") @db.Uuid // tracks belong to a stage (ثانوي عام/أزهري/بكالوريا)
  code      String   @unique // 'general-sci-science' | 'bacc-medicine' | ...
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stage           Stage             @relation(fields: [stageId], references: [id])
  gradeTracks     GradeLevelTrack[]
  offerings       SubjectOffering[]
  studentProfiles StudentProfile[]
  courses         Course[]

  @@index([stageId, isActive, sortOrder])
  @@map("tracks")
}

// A row here means "this grade level asks for this track" — the data-driven
// grade-range: أولى ثانوي has no rows, so the wizard auto-skips the track step.
model GradeLevelTrack {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gradeLevelId String @map("grade_level_id") @db.Uuid
  trackId      String @map("track_id") @db.Uuid

  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  track      Track      @relation(fields: [trackId], references: [id])

  @@unique([gradeLevelId, trackId])
  @@index([trackId])
  @@map("grade_level_tracks")
}

model Subject {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique // 'math', 'quran-tajweed', 'lang2-french', ...
  nameAr           String   @map("name_ar")
  nameEn           String?  @map("name_en")
  language         Locale   @default(ar) // instruction language (عربي/إنجليزي)
  isAzhari         Boolean  @default(false) @map("is_azhari") // المواد الشرعية
  isSecondLanguage Boolean  @default(false) @map("is_second_language") // فرنسي/ألماني/...
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  offerings              SubjectOffering[]
  teacherSubjects        TeacherSubject[]
  secondLanguageStudents StudentProfile[]  @relation("StudentSecondLanguage")
  courses                Course[]

  @@index([isActive, sortOrder])
  @@map("subjects")
}

// "Where is this subject taught" — the matching key for wizards and content
// filtering. track_id NULL = offered to the whole grade level (all tracks, or
// a grade that has no tracks) — hence ON DELETE RESTRICT, never SET NULL,
// which would silently widen an offering to every track. True uniqueness
// incl. NULL track is a NULLS NOT DISTINCT unique index in the migration.
model SubjectOffering {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  gradeLevelId String   @map("grade_level_id") @db.Uuid
  trackId      String?  @map("track_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject    Subject    @relation(fields: [subjectId], references: [id])
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  track      Track?     @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@index([gradeLevelId, trackId])
  @@index([subjectId])
  @@map("subject_offerings")
}

// Teacher self-service catalog links (onboarding §5). teacher_id follows the
// repo-wide convention: it is users.id (via teacher_profiles.user_id).
model TeacherGradeLevel {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId    String @map("teacher_id") @db.Uuid
  gradeLevelId String @map("grade_level_id") @db.Uuid

  teacherProfile TeacherProfile @relation(fields: [teacherId], references: [userId])
  gradeLevel     GradeLevel     @relation(fields: [gradeLevelId], references: [id])

  @@unique([teacherId, gradeLevelId])
  @@index([gradeLevelId])
  @@map("teacher_grade_levels")
}

model TeacherSubject {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  teacherProfile TeacherProfile @relation(fields: [teacherId], references: [userId])
  subject        Subject        @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

// Center coverage (onboarding §6): which stages the center serves. The system
// is derivable from the stage. Tenant-scoped (has center_id) → joins the
// standard tenant_isolation RLS list.
model CenterStage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId String @map("center_id") @db.Uuid
  stageId  String @map("stage_id") @db.Uuid

  center Center @relation(fields: [centerId], references: [id])
  stage  Stage  @relation(fields: [stageId], references: [id])

  @@unique([centerId, stageId])
  @@index([centerId])
  @@map("center_stages")
}

// "اطلب إضافة مادة" — teachers request missing subjects; super_admin reviews
// (§5/§8). Plain UUID columns (no relations) per the repo's request-table
// style (cf. enrollment_requests); names resolved app-side.
model SubjectRequest {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedById    String               @map("requested_by_id") @db.Uuid // teacher users.id
  suggestedName    String               @map("suggested_name")
  gradeLevelId     String?              @map("grade_level_id") @db.Uuid // optional context
  notes            String?
  status           SubjectRequestStatus @default(pending)
  reviewedBy       String?              @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  reviewNote       String?              @map("review_note")
  createdSubjectId String?              @map("created_subject_id") @db.Uuid // set on approval
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([requestedById])
  @@map("subject_requests")
}

// ---------------------------------------------------------------------------
// Online payments — Step 3 (Paymob foundation). Money-table style: plain UUID
// columns, no relations (cf. Payment/Transaction). State machine is one-way
// (pending -> paid | failed | expired), enforced by claim-style conditional
// updates in code. App-layer scoped — NOT in the tenant_isolation RLS set.
// ---------------------------------------------------------------------------

enum PaymentGateway {
  mock
  paymob

  @@map("payment_gateway")
}

enum PaymentIntentMethod {
  card // Paymob card iframe
  wallet // Paymob mobile wallets

  @@map("payment_intent_method")
}

enum PaymentIntentStatus {
  pending
  paid
  failed
  expired

  @@map("payment_intent_status")
}

// What a paid intent settles into. Default keeps every existing row a
// subscription/course charge; wallet_topup dispatches to the wallet crediter.
enum PaymentIntentPurpose {
  subscription
  wallet_topup
  parent_wallet_topup // money into a PARENT's wallet — no beneficiary student

  @@map("payment_intent_purpose")
}

model PaymentIntent {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The student the money is FOR. NULL only for purpose=parent_wallet_topup,
  // which has no beneficiary (it is platform float until the parent spends it);
  // a DB CHECK (payment_intents_student_required) holds that to the one purpose.
  studentId      String?              @map("student_id") @db.Uuid
  // Who is PAYING. NULL = the student themselves — what every pre-parent-wallet
  // row means. Set to the parent's user id when a guardian pays.
  payerUserId    String?              @map("payer_user_id") @db.Uuid
  purpose        PaymentIntentPurpose @default(subscription)
  courseId       String?              @map("course_id") @db.Uuid
  subscriptionId String?              @map("subscription_id") @db.Uuid // Step 4: intent pays for a subscription
  centerId       String?              @map("center_id") @db.Uuid // snapshot from the course at initiate time (nullable for future teacher-direct)
  amount         Int // piasters — ALWAYS server-set from the course, never from the client
  currency       String               @default("EGP")
  method         PaymentIntentMethod
  gateway        PaymentGateway
  status         PaymentIntentStatus  @default(pending)
  idempotencyKey String               @unique @map("idempotency_key") // dedupes initiate retries
  gatewayOrderId String?              @unique @map("gateway_order_id") // webhook idempotency anchor
  gatewayRef     String?              @map("gateway_ref")
  failureReason  String?              @map("failure_reason")
  webhookPayload Json?                @map("webhook_payload") // raw last webhook body, stored verbatim
  paymentId      String?              @map("payment_id") @db.Uuid // settlement linkage -> payments.id
  transactionId  String?              @map("transaction_id") @db.Uuid // settlement linkage -> transactions.id
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(6)
  paidAt         DateTime?            @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([centerId, createdAt(sort: Desc)])
  @@index([payerUserId])
  @@map("payment_intents")
}

// ---------------------------------------------------------------------------
// Student Wallet — a real-money prepaid balance.
//
// WalletLedger is the append-only source of truth (mirrors PointsLedger:
// signed delta + running balanceAfter). StudentProfile.walletBalance is the
// reconciled cache (SUM(delta) == walletBalance == last balanceAfter), with a
// DB CHECK (>= 0) floor. Every movement writes ONE ledger row + updates the
// cache in the SAME tx. Append-only via the immutability extension
// (WalletLedger added to IMMUTABLE_MODELS). Cash top-ups carry recordedBy +
// centerId for full audit attribution; centers can only credit, never debit.
// ---------------------------------------------------------------------------

enum WalletEntryType {
  topup // money added (cash at center, or online via Paymob)
  payment // spent on a subscription/session (internal transfer)
  refund // returned from a refunded charge
  adjustment // manual/superadmin correction

  @@map("wallet_entry_type")
}

model WalletLedger {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String          @map("student_id") @db.Uuid
  type            WalletEntryType
  delta           Int // signed piasters: +topup/refund, -payment
  balanceAfter    Int             @map("balance_after") // running balance snapshot
  method          PaymentMethod? // cash | online_paymob for top-ups; wallet for spends
  refNumber       String?         @map("ref_number") // links the mirrored Transaction ref
  paymentId       String?         @map("payment_id") @db.Uuid
  paymentIntentId String?         @map("payment_intent_id") @db.Uuid
  subscriptionId  String?         @map("subscription_id") @db.Uuid
  relatedTxnId    String?         @map("related_txn_id") @db.Uuid // the Transaction this mirrors
  centerId        String?         @map("center_id") @db.Uuid // crediting center for cash top-ups (audit)
  reason          String?
  recordedBy      String?         @map("recorded_by") @db.Uuid // staff/actor who credited (audit)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([studentId])
  @@index([studentId, createdAt(sort: Desc)])
  @@map("wallet_ledger")
}

// Superadmin wallet policy (PRD §5.6). Singleton row (one global config).
model WalletSettings {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // DEPRECATED (2026-07-23): the student wallet balance cap was removed — no
  // code reads this column any more. Kept inert (nullable, nulled by migration
  // 20260723130000_drop_wallet_balance_cap) rather than dropped.
  maxBalance Int?     @map("max_balance")
  minTopup   Int      @default(1000) @map("min_topup") // 10 EGP
  maxTopup   Int      @default(500000) @map("max_topup") // 5000 EGP
  updatedBy  String?  @map("updated_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("wallet_settings")
}

// ---------------------------------------------------------------------------
// Parent Wallet — the same real-money prepaid balance, owned by a PARENT, so a
// guardian can pay for their own child's lesson out of their own money.
//
// Deliberately a SIBLING of WalletLedger rather than a nullable-owner column on
// it: wallet_ledger.student_id is NOT NULL and the student wallet is proven
// money code, so widening it would change the meaning of every query built on
// it. Same invariants as the student wallet — append-only source of truth
// (IMMUTABLE_MODELS), ParentProfile.walletBalance as the reconciled cache
// (SUM(delta) == walletBalance == last balanceAfter), DB CHECK (>= 0) floor,
// one ledger row + one cache update per movement in the SAME tx.
//
// Money direction is UNCHANGED by this table: a parent-funded subscription
// still moves student -> center/teacher in the Transaction ledger. This records
// only the FUNDING leg, plus which child it was spent on.
// ---------------------------------------------------------------------------

model ParentWalletLedger {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId             String          @map("parent_id") @db.Uuid
  beneficiaryStudentId String?         @map("beneficiary_student_id") @db.Uuid // which child a spend was for; NULL on top-ups
  type                 WalletEntryType
  delta                Int // signed piasters: +topup/refund, -payment
  balanceAfter         Int             @map("balance_after") // running balance snapshot
  method               PaymentMethod? // online_paymob for top-ups; wallet for spends
  refNumber            String?         @map("ref_number") // links the mirrored Transaction ref
  paymentId            String?         @map("payment_id") @db.Uuid
  paymentIntentId      String?         @map("payment_intent_id") @db.Uuid
  subscriptionId       String?         @map("subscription_id") @db.Uuid
  relatedTxnId         String?         @map("related_txn_id") @db.Uuid // the Transaction this mirrors
  reason               String?
  recordedBy           String?         @map("recorded_by") @db.Uuid // actor who moved it (audit)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([parentId, createdAt(sort: Desc)])
  @@index([beneficiaryStudentId])
  @@map("parent_wallet_ledger")
}

// ---------------------------------------------------------------------------
// Subscriptions — Step 4. A subscription links a student to EITHER an
// individual teacher OR a center (exactly one, CHECK-enforced) and WRAPS
// enrollment: the enrollment stays the roster link, the subscription is the
// payment-coverage layer that access/attendance checks consult.
// Money-table style columns; center-target rows are tenant-RLS-visible to
// their center, teacher-target rows (center_id NULL) are bypass-only per the
// documented RLS convention.
// ---------------------------------------------------------------------------

enum SubscriptionTarget {
  teacher
  center

  @@map("subscription_target")
}

enum SubscriptionPlan {
  monthly // covers one month from activation; manual renewal, no auto-charge
  per_session // single-session pass tied to a specific session

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  pending_payment
  active
  expired
  cancelled

  @@map("subscription_status")
}

enum SubscriptionSource {
  online
  walk_in

  @@map("subscription_source")
}

model Subscription {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String             @map("student_id") @db.Uuid
  targetType      SubscriptionTarget @map("target_type")
  teacherId       String             @map("teacher_id") @db.Uuid // course teacher, ALWAYS set; the target when targetType=teacher
  centerId        String?            @map("center_id") @db.Uuid // the target when targetType=center; NULL for teacher-direct
  courseId        String             @map("course_id") @db.Uuid
  sessionId       String?            @map("session_id") @db.Uuid // per_session plan: the covered session
  subjectId       String?            @map("subject_id") @db.Uuid // snapshots from the course at creation time
  gradeLevelId    String?            @map("grade_level_id") @db.Uuid
  trackId         String?            @map("track_id") @db.Uuid
  plan            SubscriptionPlan
  price           Int // piasters — server-side snapshot of the chosen plan price
  currency        String             @default("EGP")
  paymentMethod   PaymentMethod?     @map("payment_method") // cash | online_paymob, set when paid
  status          SubscriptionStatus @default(pending_payment)
  source          SubscriptionSource
  periodStart     DateTime?          @map("period_start") @db.Timestamptz(6) // monthly coverage window
  periodEnd       DateTime?          @map("period_end") @db.Timestamptz(6)
  enrollmentId    String?            @map("enrollment_id") @db.Uuid // the wrapped enrollment
  paymentIntentId String?            @map("payment_intent_id") @db.Uuid // online payment linkage
  paymentId       String?            @map("payment_id") @db.Uuid // settlement linkage
  createdBy       String?            @map("created_by") @db.Uuid // center staff for walk-ins (audit)
  dataSource      DataSource         @default(system) @map("data_source") // provenance
  activatedAt     DateTime?          @map("activated_at") @db.Timestamptz(6)
  cancelledAt     DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  // Demo/seed marker (explicit on this table per the Step 4 review decision).
  isDemo          Boolean            @default(false) @map("is_demo")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([courseId, status])
  @@index([centerId, status])
  @@index([teacherId, status])
  @@index([status, periodEnd]) // expiry sweep
  @@index([sessionId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Commission settings — Step 4.5. Scoped rows: the single `global` row is the
// platform default; per-center / per-teacher override rows can be added later
// WITHOUT a migration (resolution: teacher > center > global > code fallback).
// Platform-global config, superadmin-managed — app-scoped, no RLS.
// ---------------------------------------------------------------------------

enum CommissionScope {
  global
  center
  teacher
  room

  @@map("commission_scope")
}

model CommissionSetting {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope                     CommissionScope @default(global)
  centerId                  String?         @map("center_id") @db.Uuid // set when scope=center
  teacherId                 String?         @map("teacher_id") @db.Uuid // set when scope=teacher
  roomId                    String?         @map("room_id") @db.Uuid // set when scope=room
  // Flat commission (global/teacher/center rows). NULL on split-only override
  // rows (center/room revenue-split rows carry only the *_share_bp columns).
  teacherDirectCommissionBp Int?            @map("teacher_direct_commission_bp") // basis points (1500 = 15%)
  platformTeacherFee        Int?            @map("platform_teacher_fee") // piasters per present student (center split)
  platformCenterFee         Int?            @map("platform_center_fee") // piasters per present student (center split)
  // Room-based 3-way revenue split (basis points). Resolution room > center >
  // global (resolveRevenueSplit). NULL on legacy rows = split not configured at
  // that scope. All three set + sum to 10000 when present (DB CHECK).
  platformShareBp           Int?            @map("platform_share_bp")
  teacherShareBp            Int?            @map("teacher_share_bp")
  centerShareBp             Int?            @map("center_share_bp")
  // Method 2 (per-attending-student) center rate — superadmin-only, resolution
  // room > center > global (resolveMethod2Rate). AT MOST ONE of the two set per
  // row (DB CHECK commission_m2_rate_shape): a flat piasters fee per attending
  // student, OR basis points of the per-session price per attending student.
  centerPerStudentFee       Int?            @map("center_per_student_fee")
  centerPerStudentBp        Int?            @map("center_per_student_bp")
  updatedBy                 String?         @map("updated_by") @db.Uuid
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([scope])
  @@map("commission_settings")
}

// ---------------------------------------------------------------------------
// Collaboration requests — Step 5. REPLACES ClassroomBooking and absorbs the
// existing-teacher affiliation invite (approved decision #3). Either side
// (teacher or center) proposes a class: catalog subject/grade/track, optional
// hall, schedule, optional expected students, and the centerShare the money
// engine will use. Acceptance transactionally creates the affiliation, the
// course, and its sessions. Center-scoped RLS like other center tables.
// ---------------------------------------------------------------------------

enum CollaborationInitiator {
  teacher
  center

  @@map("collaboration_initiator")
}

enum CollaborationStatus {
  pending
  accepted
  rejected
  cancelled
  expired

  @@map("collaboration_status")
}

model CollaborationRequest {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  initiator             CollaborationInitiator
  teacherId             String                 @map("teacher_id") @db.Uuid
  centerId              String                 @map("center_id") @db.Uuid
  subjectId             String                 @map("subject_id") @db.Uuid // catalog FK — no free text
  gradeLevelId          String                 @map("grade_level_id") @db.Uuid
  trackId               String?                @map("track_id") @db.Uuid
  roomId                String?                @map("room_id") @db.Uuid // optional hall; must belong to centerId
  daysOfWeek            Int[]                  @map("days_of_week")
  startTime             String                 @map("start_time") // "HH:MM"
  endTime               String                 @map("end_time")
  startDate             DateTime               @map("start_date") @db.Timestamptz(6)
  endDate               DateTime?              @map("end_date") @db.Timestamptz(6) // acceptance defaults +3 months
  expectedStudents      Int?                   @map("expected_students") // OPTIONAL — zero-student teachers can apply
  proposedCenterShare   Int                    @map("proposed_center_share") // piasters; the money-engine centerShare
  // Room pricing method proposed for a room-based request. Forced rooms carry
  // the forced value; both-methods rooms carry the TEACHER's choice (creation
  // for teacher-initiated requests, accept time for center-initiated ones —
  // NULL until then). Ignored when roomId is NULL.
  proposedPricingMethod RoomPricingMethod?     @map("proposed_pricing_method")
  message               String?
  status                CollaborationStatus    @default(pending)
  respondedAt           DateTime?              @map("responded_at") @db.Timestamptz(6)
  respondedBy           String?                @map("responded_by") @db.Uuid
  responseNote          String?                @map("response_note")
  courseId              String?                @map("course_id") @db.Uuid // acceptance linkage
  affiliationId         String?                @map("affiliation_id") @db.Uuid // acceptance linkage
  expiresAt             DateTime               @map("expires_at") @db.Timestamptz(6) // pending TTL
  createdBy             String                 @map("created_by") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([teacherId, status])
  @@index([centerId, status])
  @@index([status, expiresAt])
  @@map("collaboration_requests")
}

// ---------------------------------------------------------------------------
// Per-session settlement records (Room Pricing Methods). A queryable projection
// written in the SAME transaction as distributeSessionRevenue for ROOM-BASED
// courses (both methods) — the transactions ledger stays the money source of
// truth. present_count freezes the settled attendee set, so post-settlement
// attendance edits become DETECTABLE (superadmin oversight) instead of silent.
// Append-only: runtime immutability extension + SQL REVOKE UPDATE/DELETE.
// UNIQUE(session_id) is a second exactly-once witness beside distributed_at.
// ---------------------------------------------------------------------------

model SessionSettlement {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String            @unique @map("session_id") @db.Uuid // loose ref (no FK), like transactions.lesson_id
  courseId        String            @map("course_id") @db.Uuid
  centerId        String            @map("center_id") @db.Uuid // RLS tenant key
  teacherId       String            @map("teacher_id") @db.Uuid
  roomId          String?           @map("room_id") @db.Uuid
  pricingMethod   RoomPricingMethod @map("pricing_method")
  presentCount    Int               @map("present_count")
  perSessionPrice Int               @map("per_session_price") // piasters
  platformTotal   Int               @map("platform_total") // piasters, presentCount × platform cut
  centerTotal     Int               @map("center_total") // piasters, presentCount × center share
  teacherTotal    Int               @map("teacher_total") // piasters, presentCount × teacher net
  m2CenterFee     Int?              @map("m2_center_fee") // Method-2 flat rate used (piasters/student)
  m2CenterBp      Int?              @map("m2_center_bp") // Method-2 bp rate used
  settledBy       String            @map("settled_by") @db.Uuid // actor who completed the session
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([centerId, createdAt(sort: Desc)])
  @@index([courseId])
  @@map("session_settlements")
}

// =============================================================================
// MARKETING / CONVERSION
// =============================================================================

enum ContactSubmissionStatus {
  new
  handled
  spam

  @@map("contact_submission_status")
}

/// Public «تواصل معنا» form submissions. Platform-scoped, NOT tenant data: a
/// submission arrives before the sender has any account or center, so there is
/// no center_id to isolate on and no RLS policy (same posture as
/// commission_settings). Written by apps/www `POST /api/v1/contact`; read from
/// the back office only.
///
/// Most columns are nullable because the table serves any future public form,
/// not only this one — the CURRENT form's own requirements (a real name, a
/// valid email, a bounded message, an enum subject) are enforced by the zod
/// schema on the route, which is where a per-form rule belongs.
model ContactSubmission {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String?
  phone       String?
  /// Free text at the DB level; the website form constrains it to
  /// demo | pricing | support | partnership | other so the queue can filter.
  subject     String?
  message     String
  locale      Locale                  @default(ar)
  /// Which public form produced the row, so a second one stays separable.
  source      String?
  /// Set only if a signed-in user happened to submit; the form does not need one.
  userId      String?                 @map("user_id") @db.Uuid
  ipAddress   String?                 @map("ip_address") @db.Inet
  userAgent   String?                 @map("user_agent")
  status      ContactSubmissionStatus @default(new)
  handledBy   String?                 @map("handled_by") @db.Uuid
  handledAt   DateTime?               @map("handled_at") @db.Timestamptz(6)
  handledNote String?                 @map("handled_note")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("contact_submissions")
}
