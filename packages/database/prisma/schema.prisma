  body         String
  data         Json               @default("{}")
  channels     String[]           @default([]) // ['fcm','email','sms']
  status       NotificationStatus @default(pending)
  fcmMessageId String?            @map("fcm_message_id")
  read         Boolean            @default(false)
  readAt       DateTime?          @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([read])
  @@map("notifications")
}

model BlacklistEntry {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetId    String         @map("target_id") @db.Uuid
  level       BlacklistLevel
  centerId    String?        @map("center_id") @db.Uuid // scope for center/teacher levels
  imposedById String         @map("imposed_by_id") @db.Uuid
  reason      String
  isActive    Boolean        @default(true) @map("is_active")
  removedAt   DateTime?      @map("removed_at") @db.Timestamptz(6)
  removedBy   String?        @map("removed_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetId])
  @@index([centerId])
  @@index([level])
  @@map("blacklist_entries")
}

/// H-04 — the record of what a blacklist actually DID, so lifting it can give
/// back exactly that and nothing else. One append-only row per entity removed
/// by a blacklist, keyed to the BlacklistEntry that removed it; the lift stamps
/// `reversedAt` + `reversal` on each. Never matched by timestamp: a blacklist
/// can be applied and lifted repeatedly, and each entry owns its own rows.
/// Roster bookkeeping only — nothing here touches the money ledger.
model BlacklistCascadeAction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId    String   @map("entry_id") @db.Uuid // BlacklistEntry that caused the removal
  targetId   String   @map("target_id") @db.Uuid
  entityType String   @map("entity_type") // 'enrollment' — the seam for future cascades
  entityId   String   @map("entity_id") @db.Uuid
  centerId   String?  @map("center_id") @db.Uuid // scope snapshot; NULL = teacher-direct course
  courseId   String   @map("course_id") @db.Uuid
  prevStatus String   @map("prev_status")
  appliedAt  DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  // NULL while outstanding — a lift only ever considers those, which is what
  // makes reversal idempotent and blacklist→lift→blacklist cycles independent.
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)
  reversal   String? // restored | restored_over_capacity | skipped_* (DB CHECK)
  reversedBy String?  @map("reversed_by") @db.Uuid

  @@unique([entryId, entityType, entityId])
  @@index([targetId, appliedAt(sort: Desc)])
  @@map("blacklist_cascade_actions")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String // e.g. 'center.approved', 'blacklist.added'
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  centerId    String?  @map("center_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  // Step 8: set when an assistant acted for their teacher (actorId = assistant).
  onBehalfOf  String?  @map("on_behalf_of") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([centerId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

