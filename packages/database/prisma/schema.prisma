generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  super_admin
  accountant
  center_admin
  center_staff
  teacher
  assistant
  parent
  student

  @@map("role")
}

enum CenterStaffRole {
  receptionist
  manager
  center_accountant

  @@map("center_staff_role")
}

enum UserStatus {
  active
  shell
  pending
  suspended
  blacklisted
  deleted

  @@map("user_status")
}

enum Locale {
  ar
  en

  @@map("locale")
}

enum Theme {
  light
  dark
  system

  @@map("theme")
}

enum EntityType {
  registered
  invited
  external
  shadow

  @@map("entity_type")
}

enum TeacherSystemStatus {
  enrolled
  external

  @@map("teacher_system_status")
}

enum TeacherAccessLevel {
  full
  read_only

  @@map("teacher_access_level")
}

enum DataSource {
  system
  manual

  @@map("data_source")
}

enum CenterStatus {
  pending
  active
  suspended
  rejected
  blacklisted

  @@map("center_status")
}

enum AffiliationStatus {
  pending
  active
  declined
  expired
  removed

  @@map("affiliation_status")
}

enum CourseStatus {
  active
  ended
  cancelled

  @@map("course_status")
}

enum SessionStatus {
  scheduled
  ongoing
  cancelled
  postponed
  completed

  @@map("session_status")
}

enum EnrollmentStatus {
  active
  unenrolled

  @@map("enrollment_status")
}

enum EnrollmentRequestStatus {
  pending
  approved
  declined
  cancelled
  expired

  @@map("enrollment_request_status")
}

enum ParentLinkStatus {
  pending
  approved
  rejected
  revoked

  @@map("parent_link_status")
}

enum LinkActor {
  parent
  student

  @@map("link_actor")
}

enum AttendanceStatus {
  present
  absent
  late
  excused
  removed
  counter_only

  @@map("attendance_status")
}

enum AttendanceMode {
  counter_only
  counter_and_door

  @@map("attendance_mode")
}

enum GradeType {
  numeric
  letter

  @@map("grade_type")
}

enum MaterialType {
  lecture
  homework
  exam
  other

  @@map("material_type")
}

enum MaterialStorage {
  cloudinary
  external

  @@map("material_storage")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded

  @@map("payment_status")
}

enum ExpenseCategory {
  rent
  utilities
  salaries
  supplies
  marketing
  maintenance
  other

  @@map("expense_category")
}

enum DeletionStatus {
  pending
  approved
  rejected
  cancelled

  @@map("deletion_status")
}

enum DeletionOrigin {
  self
  guardian
  center

  @@map("deletion_origin")
}

enum DataExportStatus {
  pending
  processing
  ready
  failed
  expired

  @@map("data_export_status")
}

enum InvitePurpose {
  student_activation
  teacher_activation
  admin_invite
  walk_in_onboarding
  assistant_invite
  center_staff_invite
  teacher_invite
  guardian_email_verification

  @@map("invite_purpose")
}

enum DevicePlatform {
  ios
  android
  web

  @@map("device_platform")
}

enum TransactionType {
  payment
  commission
  payout
  refund
  adjustment

  @@map("transaction_type")
}

enum TransactionStatus {
  pending
  completed
  failed
  reversed

  @@map("transaction_status")
}

enum PaymentMethod {
  cash
  online_paymob
  online_fawry
  wallet
  instapay
  pos_card
  mobile_wallet
  unknown

  @@map("payment_method")
}

enum InvoiceType {
  payment_receipt
  student_invoice
  teacher_statement
  center_statement

  @@map("invoice_type")
}

enum InvoiceStatus {
  issued
  paid
  void

  @@map("invoice_status")
}

enum PayoutStatus {
  pending
  approved
  paid
  rejected
  cancelled

  @@map("payout_status")
}

enum BeneficiaryType {
  teacher
  center

  @@map("beneficiary_type")
}

enum BlacklistLevel {
  platform
  center
  teacher

  @@map("blacklist_level")
}

enum NotificationStatus {
  pending
  sent
  failed

  @@map("notification_status")
}

enum NotificationType {
  absence_marked
  attendance_corrected
  session_cancelled
  session_postponed
  course_cancelled
  grade_entered
  material_uploaded
  payment_recorded
  payment_refunded
  enrollment_request_submitted
  enrollment_request_approved
  enrollment_request_declined
  student_added_to_roster
  teacher_invited
  parent_link_requested
  admin_broadcast
  password_reset_requested
  shell_activation_invite
  registration_approved
  registration_rejected
  blacklist_action
  enrollment_restored_over_capacity
  payout_approved
  classroom_request
  classroom_request_decided
  lesson_reminder
  homework_deadline
  invite_code_sent
  guardian_contact_required
  new_chat_message
  chat_group_message
  chat_report_filed
  team_note_created
  team_note_status_changed
  subscription_expiring

  @@map("notification_type")
}

enum BotType {
  support
  academic

  @@map("bot_type")
}

enum SubjectRequestStatus {
  pending
  approved
  rejected

  @@map("subject_request_status")
}

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String?    @map("password_hash")
  role             Role
  name             String
  searchText       String?    @map("search_text")
  locale           Locale     @default(ar)
  theme            Theme      @default(system)
  status           UserStatus @default(active)
  emailVerified    Boolean    @default(false) @map("email_verified")
  tokenVersion     Int        @default(0) @map("token_version")
  image            String?
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  banned           Boolean    @default(false)
  banReason        String?    @map("ban_reason")
  banExpires       DateTime?  @map("ban_expires") @db.Timestamptz(6)
  fcmToken         String?    @map("fcm_token")
  isDemo           Boolean    @default(false) @map("is_demo")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)

  studentProfile      StudentProfile?
  parentProfile       ParentProfile?
  teacherProfile      TeacherProfile?
  centerAdminProfile  CenterAdminProfile?
  prefs               UserPrefs?
  authSessions        AuthSession[]
  authAccounts        AuthAccount[]
  twoFactors          TwoFactor[]
  dataExportRequests  DataExportRequest[]
  systemStatusChanges TeacherSystemStatusChange[] @relation("TeacherStatusChangeTeacher")
  externalSettlements ExternalTeacherSettlement[] @relation("ExternalSettlementTeacher")

  @@index([role])
  @@index([status])
  @@map("users")
}

model StudentProfile {
  id                         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String?    @unique @map("user_id") @db.Uuid
  fullName                   String     @map("full_name")
  searchText                 String?    @map("search_text")
  phone                      String?
  grade                      String?
  familyLinkCode             String     @unique @map("family_link_code")
  onboardingEmailSentAt      DateTime?  @map("onboarding_email_sent_at") @db.Timestamptz(6)
  studentCode                String     @unique @default(dbgenerated("gen_student_code()")) @map("student_code")
  entityType                 EntityType @default(registered) @map("entity_type")
  inviteCode                 String?    @unique @map("invite_code")
  nationalId                 String?    @unique @map("national_id")
  dateOfBirth                DateTime?  @map("date_of_birth") @db.Date
  dateOfBirthVerifiedAt      DateTime?  @map("date_of_birth_verified_at") @db.Timestamptz(6)
  dateOfBirthVerifiedBy      String?    @map("date_of_birth_verified_by") @db.Uuid
  guardianEmail              String?    @map("guardian_email")
  guardianPhone              String?    @map("guardian_phone")
  guardianEmailAddedAt       DateTime?  @map("guardian_email_added_at") @db.Timestamptz(6)
  guardianEmailAddedBy       String?    @map("guardian_email_added_by") @db.Uuid
  guardianEmailVerifiedAt    DateTime?  @map("guardian_email_verified_at") @db.Timestamptz(6)
  guardianEmailVerifiedValue String?    @map("guardian_email_verified_value")
  guardianContactDueAt       DateTime?  @map("guardian_contact_due_at") @db.Timestamptz(6)
  qrVersion                  Int        @default(1) @map("qr_version")
  qrIssuedAt                 DateTime?  @map("qr_issued_at") @db.Timestamptz(6)
  qrRevokedAt                DateTime?  @map("qr_revoked_at") @db.Timestamptz(6)
  qrRevokedReason            String?    @map("qr_revoked_reason")
  pointsBalance              Int        @default(0) @map("points_balance")
  walletBalance              Int        @default(0) @map("wallet_balance")
  savedAreaCity              String?    @map("saved_area_city")
  savedAreaLat               Float?     @map("saved_area_lat")
  savedAreaLng               Float?     @map("saved_area_lng")
  invitationSentAt           DateTime?  @map("invitation_sent_at") @db.Timestamptz(6)
  claimedAt                  DateTime?  @map("claimed_at") @db.Timestamptz(6)
  educationSystemId          String?    @map("education_system_id") @db.Uuid
  stageId                    String?    @map("stage_id") @db.Uuid
  gradeLevelId               String?    @map("grade_level_id") @db.Uuid
  trackId                    String?    @map("track_id") @db.Uuid
  secondLanguageSubjectId    String?    @map("second_language_subject_id") @db.Uuid
  onboardingCompleted        Boolean    @default(false) @map("onboarding_completed")
  onboardingDraft            Json?      @map("onboarding_draft")
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User?            @relation(fields: [userId], references: [id])
  educationSystem       EducationSystem? @relation(fields: [educationSystemId], references: [id], onDelete: Restrict)
  stage                 Stage?           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  gradeLevel            GradeLevel?      @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  track                 Track?           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  secondLanguageSubject Subject?         @relation("StudentSecondLanguage", fields: [secondLanguageSubjectId], references: [id], onDelete: Restrict)

  @@index([gradeLevelId, trackId])
  @@index([guardianContactDueAt])
  @@map("student_profiles")
}

model ParentProfile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  walletBalance Int      @default(0) @map("wallet_balance")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("parent_profiles")
}

model TeacherProfile {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  bio                 String?
  subjects            String[]
  qualifications      String?
  experienceYears     Int                 @default(0) @map("experience_years")
  photoUrl            String?             @map("photo_url")
  lessonPrice         Int?                @map("lesson_price")
  ratingAvg           Float               @default(0) @map("rating_avg")
  ratingCount         Int                 @default(0) @map("rating_count")
  walletBalance       Int                 @default(0) @map("wallet_balance")
  certificates        Json?
  onboardingCompleted Boolean             @default(false) @map("onboarding_completed")
  onboardingDraft     Json?               @map("onboarding_draft")
  attendanceMode      AttendanceMode      @default(counter_only) @map("attendance_mode")
  systemStatus        TeacherSystemStatus @default(enrolled) @map("system_status")
  accessLevel         TeacherAccessLevel  @default(full) @map("access_level")
  managedByCenterId   String?             @map("managed_by_center_id") @db.Uuid
  dataSource          DataSource          @default(system) @map("data_source")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                @relation(fields: [userId], references: [id])
  managedByCenter Center?             @relation("ExternalTeacherManager", fields: [managedByCenterId], references: [id], onDelete: Restrict)
  gradeLevels     TeacherGradeLevel[]
  subjectRefs     TeacherSubject[]

  @@index([subjects])
  @@index([systemStatus])
  @@index([managedByCenterId])
  @@map("teacher_profiles")
}

model TeacherSystemStatusChange {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId     String              @map("teacher_id") @db.Uuid
  centerId      String              @map("center_id") @db.Uuid
  fromStatus    TeacherSystemStatus @map("from_status")
  toStatus      TeacherSystemStatus @map("to_status")
  reason        String
  recordsBefore Json                @map("records_before")
  actorId       String              @map("actor_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher User   @relation("TeacherStatusChangeTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  center  Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@index([teacherId, createdAt(sort: Desc)])
  @@index([centerId, createdAt(sort: Desc)])
  @@map("teacher_system_status_changes")
}

model ExternalTeacherSettlement {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId         String        @map("center_id") @db.Uuid
  teacherId        String        @map("teacher_id") @db.Uuid
  periodStart      DateTime      @map("period_start") @db.Timestamptz(6)
  periodEnd        DateTime      @map("period_end") @db.Timestamptz(6)
  grossCollected   Int           @map("gross_collected")
  centerShareTotal Int           @map("center_share_total")
  platformFeeTotal Int           @map("platform_fee_total")
  teacherAccrued   Int           @map("teacher_accrued")
  amountPaid       Int           @map("amount_paid")
  paymentMethod    PaymentMethod @default(cash) @map("payment_method")
  txnRef           String?       @map("txn_ref")
  note             String?
  settledBy        String        @map("settled_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher User   @relation("ExternalSettlementTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  center  Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@index([centerId, createdAt(sort: Desc)])
  @@index([teacherId, createdAt(sort: Desc)])
  @@map("external_teacher_settlements")
}

model CenterAdminProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  centerId  String   @map("center_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id])
  center Center @relation(fields: [centerId], references: [id])

  @@index([centerId])
  @@map("center_admin_profiles")
}

model Center {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId         String?      @map("owner_user_id") @db.Uuid
  name                String
  shortId             String       @unique @map("short_id")
  description         String?
  address             String?
  area                String?
  subjects            String[]
  searchText          String?      @map("search_text")
  lat                 Float?
  lng                 Float?
  phone               String?
  whatsapp            String?
  email               String?
  logoUrl             String?      @map("logo_url")
  classroomCount      Int          @default(0) @map("classroom_count")
  entityType          EntityType   @default(registered) @map("entity_type")
  status              CenterStatus @default(pending)
  walletBalance       Int          @default(0) @map("wallet_balance")
  creditBalance       Int          @default(0) @map("credit_balance")
  receiptSeq          Int          @default(0) @map("receipt_seq")
  governorate         String?
  onboardingCompleted Boolean      @default(false) @map("onboarding_completed")
  onboardingDraft     Json?        @map("onboarding_draft")
  isDemo              Boolean      @default(false) @map("is_demo")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  admins           CenterAdminProfile[]
  rooms            Room[]
  courses          Course[]
  centerStages     CenterStage[]
  externalTeachers TeacherProfile[]            @relation("ExternalTeacherManager")
  teacherStatusLog TeacherSystemStatusChange[]
  externalSettles  ExternalTeacherSettlement[]

  @@index([status])
  @@index([area])
  @@map("centers")
}

model AuthSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String   @unique
  userId         String   @map("user_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  centerId       String?  @map("center_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verifications")
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_tokens")
}

model InviteToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String?
  userId    String?       @map("user_id") @db.Uuid
  tokenHash String        @unique @map("token_hash")
  purpose   InvitePurpose
  centerId  String?       @map("center_id") @db.Uuid
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@index([userId])
  @@index([centerId])
  @@map("invite_tokens")
}

enum WhatsAppMessageStatus {
  queued
  sent
  failed

  @@map("whatsapp_message_status")
}

enum WhatsAppProvider {
  mock
  cloud_api

  @@map("whatsapp_provider")
}

model WhatsAppMessage {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientPhone    String                @map("recipient_phone")
  template          String
  params            Json?
  locale            String                @default("ar")
  status            WhatsAppMessageStatus @default(queued)
  provider          WhatsAppProvider
  providerMessageId String?               @map("provider_message_id")
  providerResponse  Json?                 @map("provider_response")
  error             String?
  userId            String?               @map("user_id") @db.Uuid
  centerId          String?               @map("center_id") @db.Uuid
  createdBy         String?               @map("created_by") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([recipientPhone, createdAt(sort: Desc)])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("whatsapp_messages")
}

model UserDeviceToken {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("user_device_tokens")
}

model WebPushSubscription {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model UserPrefs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  tourCompleted Boolean  @default(false) @map("tour_completed")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

