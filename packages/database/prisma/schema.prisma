// =============================================================================
// CORE IDENTITY
// =============================================================================

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String?    @map("password_hash")
  role             Role
  name             String
  locale           Locale     @default(ar)
  theme            Theme      @default(system)
  status           UserStatus @default(active)
  emailVerified    Boolean    @default(false) @map("email_verified")
  // L1: monotonic session epoch. Every JWT records the value at issue time; the
  // NextAuth jwt callback rejects any token whose recorded value < this column.
  // Bumped on password reset/change so all pre-existing 30-day tokens (e.g. an
  // attacker's after a compromise) are invalidated at once — server-side
  // revocation for otherwise-stateless sessions.
  tokenVersion     Int        @default(0) @map("token_version")
  // better-auth core/plugin columns (2026-08-01 migration). `image` is the
  // better-auth avatar slot (unused by our UI — Cloudinary owns media);
  // banned/banReason/banExpires belong to the admin plugin and are DISTINCT
  // from `status` (C-03 suspension stays the authoritative gate);
  // twoFactorEnabled belongs to the twoFactor plugin.
  image            String?
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  banned           Boolean    @default(false)
  banReason        String?    @map("ban_reason")
  banExpires       DateTime?  @map("ban_expires") @db.Timestamptz(6)
  fcmToken         String?    @map("fcm_token")
  // Demo/seed data marker so it can be purged before launch. Flagged on root
  // entities only (users, centers, courses); child rows inherit by ancestry.
  isDemo           Boolean    @default(false) @map("is_demo")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)

  studentProfile      StudentProfile?
  parentProfile       ParentProfile?
  teacherProfile      TeacherProfile?
  centerAdminProfile  CenterAdminProfile?
  prefs               UserPrefs?
  authSessions        AuthSession[]
  authAccounts        AuthAccount[]
  twoFactors          TwoFactor[]
  dataExportRequests  DataExportRequest[]
  // Off-system teachers: both are append-only history keyed on the TEACHER's
  // user id, and both are ON DELETE RESTRICT — a teacher who has financial or
  // conversion history can only ever be soft-deleted.
  systemStatusChanges TeacherSystemStatusChange[] @relation("TeacherStatusChangeTeacher")
  externalSettlements ExternalTeacherSettlement[] @relation("ExternalSettlementTeacher")

  @@index([role])
  @@index([status])
  @@map("users")
}

model StudentProfile {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String?    @unique @map("user_id") @db.Uuid // NULL for temporary/invited students (PRD)
  fullName                String     @map("full_name")
  phone                   String?
  grade                   String? // DEPRECATED free text — superseded by gradeLevelId (education catalog)
  familyLinkCode          String     @unique @map("family_link_code")
  // Welcome-email idempotency stamp: the sender claims it atomically
  // (updateMany WHERE null) so duplicate/retried sign-ups mail exactly once.
  onboardingEmailSentAt   DateTime?  @map("onboarding_email_sent_at") @db.Timestamptz(6)
  // The Student ID a student is handed on a card and a receptionist types at
  // the counter. v2 (20260803110000): eight characters, `G7K3M2QF` — education
  // system letter + one-way body + CHECK CHARACTER, so a single mistyped
  // character can no longer resolve to a different child. 'X' opens a PENDING
  // code (the profile exists before onboarding picks a system); it is replaced
  // exactly once by finalizeStudentCode(). The DB default still covers every
  // creation site, and a CHECK constraint holds the alphabet and the check
  // character so no writer can store a code the counter would reject.
  // See packages/server-core/src/services/students/student-code.ts.
  studentCode             String     @unique @default(dbgenerated("gen_student_code()")) @map("student_code")
  entityType              EntityType @default(registered) @map("entity_type")
  inviteCode              String?    @unique @map("invite_code")
  // ---- Manual-entry DEDUP KEY (off-system teachers).
  // When center staff type a student in by hand, the same child is very likely
  // already on the platform (with an enrolled teacher, or another center). The
  // dedup keys are `users.phone` (already globally UNIQUE) and this column.
  // UNIQUE and NULLABLE: Postgres allows many NULLs in a unique index, so
  // students without a national ID on file are unaffected, while two rows can
  // never claim the same one. `resolveOrCreateStudent` looks both keys up
  // BEFORE creating; this index is the hard backstop under that lookup.
  nationalId              String?    @unique @map("national_id")
  // ---- Child safety (messaging oversight). DEFAULT-MINOR by design: a student
  // counts as an adult ONLY when a VERIFIED date of birth proves 18+. Missing,
  // unverified, or under-18 all mean MINOR, so parent oversight stays active.
  // Erring toward more protection is the safe failure mode on a K-12 platform;
  // see isMinor() in src/queries/chat-minors.ts — the single implementation.
  dateOfBirth             DateTime?  @map("date_of_birth") @db.Date
  // Set by a super admin once the DOB is evidenced. NULL ⇒ unverified ⇒ minor,
  // no matter what dateOfBirth says.
  dateOfBirthVerifiedAt   DateTime?  @map("date_of_birth_verified_at") @db.Timestamptz(6)
  dateOfBirthVerifiedBy   String?    @map("date_of_birth_verified_by") @db.Uuid
  // ---- Guardian contact channel (child safety, approved 2026-07-25).
  // A MINOR must have a reachable GUARDIAN EMAIL before adult-facing messaging
  // (teacher / assistant / center admin / center staff) opens. See
  // hasGuardianChannel() in src/queries/chat-guardian.ts — the single rule.
  //
  // The phone is captured when the guardian has no email (very common at a
  // walk-in counter): it is kept for the record and for a future SMS/WhatsApp
  // channel, but it NEVER satisfies the gate — the gate is email-only by
  // decision, because that is the channel we can actually deliver on today.
  guardianEmail           String?    @map("guardian_email")
  guardianPhone           String?    @map("guardian_phone")
  guardianEmailAddedAt    DateTime?  @map("guardian_email_added_at") @db.Timestamptz(6)
  guardianEmailAddedBy    String?    @map("guardian_email_added_by") @db.Uuid
  // Verification: the stamp AND the exact address it was earned by. A reader
  // must compare `guardianEmailVerifiedValue` against `guardianEmail` — an
  // edited address is unverified again, however recent the stamp.
  guardianEmailVerifiedAt    DateTime? @map("guardian_email_verified_at") @db.Timestamptz(6)
  guardianEmailVerifiedValue String?   @map("guardian_email_verified_value")
  // Deadline for supplying the email. Purely an ESCALATION marker: passing it
  // never suspends the account (the student paid) and never unlocks messaging.
  // Before it, reminders are periodic; after it, the banner turns persistent
  // and the owning center is notified.
  guardianContactDueAt    DateTime?  @map("guardian_contact_due_at") @db.Timestamptz(6)
  // ---- The ID card's QR credential (20260809140000).
  // The QR is a SIGNED URL, not a picture of the code: the signature is derived
  // as HMAC(STUDENT_QR_SECRET, code|version) and is never stored, so nothing
  // here is secret material and a card can be re-rendered from this row alone.
  // What must persist is which ISSUE is currently valid — raising `qrVersion`
  // invalidates every card ever printed at the old version, at once, which is
  // the whole answer to "the student lost their card".
  // See packages/server-core/src/services/students/student-qr.ts.
  qrVersion               Int        @default(1) @map("qr_version")
  // NULL for every student who predates this column: we know when a card was
  // REISSUED, and a first-issue date we never recorded would be invented.
  qrIssuedAt              DateTime?  @map("qr_issued_at") @db.Timestamptz(6)
  // Revoked = no card is valid until one is reissued. The reason is shown to
  // whoever is holding the refused card, so a DB CHECK keeps the pair together.
  qrRevokedAt             DateTime?  @map("qr_revoked_at") @db.Timestamptz(6)
  qrRevokedReason         String?    @map("qr_revoked_reason")
  pointsBalance           Int        @default(0) @map("points_balance")
  // Student money wallet (piasters). Cached balance — the append-only
  // WalletLedger is the source of truth; reconciles as SUM(delta) == this ==
  // last balanceAfter. DB CHECK (wallet_balance >= 0) is the H2-style floor.
  walletBalance           Int        @default(0) @map("wallet_balance")
  savedAreaCity           String?    @map("saved_area_city")
  savedAreaLat            Float?     @map("saved_area_lat")
  savedAreaLng            Float?     @map("saved_area_lng")
  invitationSentAt        DateTime?  @map("invitation_sent_at") @db.Timestamptz(6)
  claimedAt               DateTime?  @map("claimed_at") @db.Timestamptz(6)
  // ---- Education catalog (onboarding §4). stage/system stored alongside
  // gradeLevel per the PRD; the API layer enforces chain consistency.
  // Catalog FKs are ON DELETE RESTRICT: admins hide via is_active, never
  // hard-delete rows students still point at.
  educationSystemId       String?    @map("education_system_id") @db.Uuid
  stageId                 String?    @map("stage_id") @db.Uuid
  gradeLevelId            String?    @map("grade_level_id") @db.Uuid
  trackId                 String?    @map("track_id") @db.Uuid
  secondLanguageSubjectId String?    @map("second_language_subject_id") @db.Uuid
  onboardingCompleted     Boolean    @default(false) @map("onboarding_completed")
  onboardingDraft         Json?      @map("onboarding_draft") // wizard auto-save (§9)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User?            @relation(fields: [userId], references: [id])
  educationSystem       EducationSystem? @relation(fields: [educationSystemId], references: [id], onDelete: Restrict)
  stage                 Stage?           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  gradeLevel            GradeLevel?      @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  track                 Track?           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  secondLanguageSubject Subject?         @relation("StudentSecondLanguage", fields: [secondLanguageSubjectId], references: [id], onDelete: Restrict)

  @@index([gradeLevelId, trackId]) // content-matching hot path
  @@index([guardianContactDueAt]) // reminder-escalation sweep
  @@map("student_profiles")
}

model ParentProfile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  walletBalance Int      @default(0) @map("wallet_balance") // piasters; DB CHECK (>= 0), H2
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("parent_profiles")
}

model TeacherProfile {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  bio                 String?
  subjects            String[] // DEPRECATED free text — superseded by teacher_subjects (education catalog)
  qualifications      String?
  experienceYears     Int                 @default(0) @map("experience_years")
  photoUrl            String?             @map("photo_url")
  lessonPrice         Int?                @map("lesson_price") // piasters (PRD teacher_profiles.lesson_price)
  ratingAvg           Float               @default(0) @map("rating_avg")
  ratingCount         Int                 @default(0) @map("rating_count")
  walletBalance       Int                 @default(0) @map("wallet_balance") // piasters; DB CHECK (>= 0), H2
  certificates        Json? // [{name, file_url, issued_by}]
  onboardingCompleted Boolean             @default(false) @map("onboarding_completed")
  onboardingDraft     Json?               @map("onboarding_draft") // wizard auto-save (§9)
  // Step 6: global per-teacher check-in mode (approved decision #4).
  attendanceMode      AttendanceMode      @default(counter_only) @map("attendance_mode")
  // ---- Off-system teachers. DEFAULT `enrolled` so every existing teacher is
  // untouched and every existing query keeps its exact meaning.
  systemStatus        TeacherSystemStatus @default(enrolled) @map("system_status")
  // What this teacher's account may do. Meaningful only once they HAVE an
  // account; an external teacher has none, so it simply carries forward.
  accessLevel         TeacherAccessLevel  @default(full) @map("access_level")
  // The center that created and keeps this external teacher's records. NOT
  // NULL whenever systemStatus = external (DB CHECK teacher_external_needs_center):
  // an off-system teacher with nobody responsible for their data is exactly the
  // orphan this feature exists to prevent. Deliberately KEPT after a conversion
  // to `enrolled` — it is the historical fact of who entered those records.
  managedByCenterId   String?             @map("managed_by_center_id") @db.Uuid
  // Provenance of the teacher record itself (see DataSource).
  dataSource          DataSource          @default(system) @map("data_source")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                @relation(fields: [userId], references: [id])
  managedByCenter Center?             @relation("ExternalTeacherManager", fields: [managedByCenterId], references: [id], onDelete: Restrict)
  gradeLevels     TeacherGradeLevel[]
  subjectRefs     TeacherSubject[]

  @@index([subjects])
  @@index([systemStatus])
  @@index([managedByCenterId])
  @@map("teacher_profiles")
}

// Append-only journal of every external <-> enrolled transition.
//
// The transition itself moves NO data (the teacher's user id never changes), so
// this table is not a migration log — it is the EVIDENCE that nothing moved:
// each row freezes the counts of the records attached to the teacher at the
// moment of the flip (`recordsBefore`), which is what makes "no history was
// lost" an assertion anyone can re-check later instead of a promise.
// Append-only at the DB level (REVOKE UPDATE/DELETE) like session_settlements.
model TeacherSystemStatusChange {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId     String              @map("teacher_id") @db.Uuid // users.id (role=teacher)
  centerId      String              @map("center_id") @db.Uuid // RLS tenant key — the center that owns the record
  fromStatus    TeacherSystemStatus @map("from_status")
  toStatus      TeacherSystemStatus @map("to_status")
  reason        String
  // {courses, sessions, enrollments, attendance, grades, payments, transactions}
  // counted inside the SAME transaction as the flip.
  recordsBefore Json                @map("records_before")
  actorId       String              @map("actor_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher User   @relation("TeacherStatusChangeTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  center  Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@index([teacherId, createdAt(sort: Desc)])
  @@index([centerId, createdAt(sort: Desc)])
  @@map("teacher_system_status_changes")
}

// The center <-> external-teacher cash settlement record ("كشف تسوية").
//
// An external teacher cannot request a payout (no account), so the CENTER hands
// them cash and records it here. The money itself still moves through the ONE
// engine: the teacher's accrued `teacher_profiles.wallet_balance` is debited
// with the same H2 conditional decrement every payout uses, and a `payout`
// Transaction is written in the same DB transaction. This table is the
// queryable statement beside it — deliberately NOT the source of truth.
//
// The period figures are a SNAPSHOT of what the statement said when it was
// settled, so a later attendance edit cannot silently rewrite history. They are
// NOT constrained to sum to `grossCollected`: money collected for a session
// that has not been completed yet is legitimately collected-but-undistributed,
// and a CHECK asserting conservation would reject that honest state.
model ExternalTeacherSettlement {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId         String        @map("center_id") @db.Uuid // RLS tenant key
  teacherId        String        @map("teacher_id") @db.Uuid
  periodStart      DateTime      @map("period_start") @db.Timestamptz(6)
  periodEnd        DateTime      @map("period_end") @db.Timestamptz(6)
  grossCollected   Int           @map("gross_collected") // piasters students paid, this teacher, this window
  centerShareTotal Int           @map("center_share_total") // the center's cut / hall rent
  platformFeeTotal Int           @map("platform_fee_total") // platform commission
  teacherAccrued   Int           @map("teacher_accrued") // what the engine credited the teacher
  amountPaid       Int           @map("amount_paid") // what the center actually handed over now
  paymentMethod    PaymentMethod @default(cash) @map("payment_method")
  txnRef           String?       @map("txn_ref") // transactions.ref_number of the payout row
  note             String?
  settledBy        String        @map("settled_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher User   @relation("ExternalSettlementTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  center  Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@index([centerId, createdAt(sort: Desc)])
  @@index([teacherId, createdAt(sort: Desc)])
  @@map("external_teacher_settlements")
}

