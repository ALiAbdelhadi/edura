// =============================================================================
// EDUCATION CATALOG  (config-driven onboarding — Egyptian market)
// -----------------------------------------------------------------------------
// Platform-global lookup tables (no center_id): system → stage → grade level
// → track, subjects, and subject_offerings ("this subject is taught THERE").
// Everything is admin-managed data; wizards and matching read it — no
// hardcoded subject/track names anywhere in business logic. `code` is the
// stable seed/reference key (ids stay opaque); is_active + sort_order give
// admins soft-hide and ordering without deletes. RLS: world-readable,
// writable only under rls_bypass() (super_admin platform context) — see the
// education_catalog migration.
// "Grade level" = school year (الصف). NOT the existing `grades` table, which
// holds exam grades.
// =============================================================================

model EducationSystem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique // 'general' | 'azhari' | 'bacc' | ...
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  iconKey   String?  @map("icon_key") // wizard card icon
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stages          Stage[]
  studentProfiles StudentProfile[]

  @@index([isActive, sortOrder])
  @@map("education_systems")
}

model Stage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  educationSystemId String   @map("education_system_id") @db.Uuid
  code              String   @unique // 'general-primary', 'azhari-secondary', ...
  nameAr            String   @map("name_ar")
  nameEn            String?  @map("name_en")
  hasSecondLanguage Boolean  @default(false) @map("has_second_language") // gates the wizard's 2nd-language step
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  system          EducationSystem  @relation(fields: [educationSystemId], references: [id])
  gradeLevels     GradeLevel[]
  tracks          Track[]
  studentProfiles StudentProfile[]
  centerStages    CenterStage[]

  @@index([educationSystemId, isActive, sortOrder])
  @@map("stages")
}

model GradeLevel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageId   String   @map("stage_id") @db.Uuid
  code      String   @unique // 'general-primary-1' ... 'bacc-secondary-3'
  nameAr    String   @map("name_ar") // "الصف الأول الابتدائي"
  nameEn    String?  @map("name_en")
  level     Int // 1..n within the stage
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stage              Stage               @relation(fields: [stageId], references: [id])
  gradeTracks        GradeLevelTrack[]
  offerings          SubjectOffering[]
  studentProfiles    StudentProfile[]
  teacherGradeLevels TeacherGradeLevel[]
  courses            Course[]

  @@index([stageId, isActive, sortOrder])
  @@map("grade_levels")
}

model Track {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageId   String   @map("stage_id") @db.Uuid // tracks belong to a stage (ثانوي عام/أزهري/بكالوريا)
  code      String   @unique // 'general-sci-science' | 'bacc-medicine' | ...
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stage           Stage             @relation(fields: [stageId], references: [id])
  gradeTracks     GradeLevelTrack[]
  offerings       SubjectOffering[]
  studentProfiles StudentProfile[]
  courses         Course[]

  @@index([stageId, isActive, sortOrder])
  @@map("tracks")
}

// A row here means "this grade level asks for this track" — the data-driven
// grade-range: أولى ثانوي has no rows, so the wizard auto-skips the track step.
model GradeLevelTrack {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gradeLevelId String @map("grade_level_id") @db.Uuid
  trackId      String @map("track_id") @db.Uuid

  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  track      Track      @relation(fields: [trackId], references: [id])

  @@unique([gradeLevelId, trackId])
  @@index([trackId])
  @@map("grade_level_tracks")
}

model Subject {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique // 'math', 'quran-tajweed', 'lang2-french', ...
  nameAr           String   @map("name_ar")
  nameEn           String?  @map("name_en")
  language         Locale   @default(ar) // instruction language (عربي/إنجليزي)
  isAzhari         Boolean  @default(false) @map("is_azhari") // المواد الشرعية
  isSecondLanguage Boolean  @default(false) @map("is_second_language") // فرنسي/ألماني/...
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  offerings              SubjectOffering[]
  teacherSubjects        TeacherSubject[]
  secondLanguageStudents StudentProfile[]  @relation("StudentSecondLanguage")
  courses                Course[]

  @@index([isActive, sortOrder])
  @@map("subjects")
}

// "Where is this subject taught" — the matching key for wizards and content
// filtering. track_id NULL = offered to the whole grade level (all tracks, or
// a grade that has no tracks) — hence ON DELETE RESTRICT, never SET NULL,
// which would silently widen an offering to every track. True uniqueness
// incl. NULL track is a NULLS NOT DISTINCT unique index in the migration.
model SubjectOffering {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  gradeLevelId String   @map("grade_level_id") @db.Uuid
  trackId      String?  @map("track_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject    Subject    @relation(fields: [subjectId], references: [id])
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  track      Track?     @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@index([gradeLevelId, trackId])
  @@index([subjectId])
  @@map("subject_offerings")
}

// Teacher self-service catalog links (onboarding §5). teacher_id follows the
// repo-wide convention: it is users.id (via teacher_profiles.user_id).
model TeacherGradeLevel {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId    String @map("teacher_id") @db.Uuid
  gradeLevelId String @map("grade_level_id") @db.Uuid

  teacherProfile TeacherProfile @relation(fields: [teacherId], references: [userId])
  gradeLevel     GradeLevel     @relation(fields: [gradeLevelId], references: [id])

  @@unique([teacherId, gradeLevelId])
  @@index([gradeLevelId])
  @@map("teacher_grade_levels")
}

model TeacherSubject {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  teacherProfile TeacherProfile @relation(fields: [teacherId], references: [userId])
  subject        Subject        @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

// Center coverage (onboarding §6): which stages the center serves. The system
// is derivable from the stage. Tenant-scoped (has center_id) → joins the
// standard tenant_isolation RLS list.
model CenterStage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  centerId String @map("center_id") @db.Uuid
  stageId  String @map("stage_id") @db.Uuid

  center Center @relation(fields: [centerId], references: [id])
  stage  Stage  @relation(fields: [stageId], references: [id])

  @@unique([centerId, stageId])
  @@index([centerId])
  @@map("center_stages")
}

// "اطلب إضافة مادة" — teachers request missing subjects; super_admin reviews
// (§5/§8). Plain UUID columns (no relations) per the repo's request-table
// style (cf. enrollment_requests); names resolved app-side.
model SubjectRequest {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedById    String               @map("requested_by_id") @db.Uuid // teacher users.id
  suggestedName    String               @map("suggested_name")
  gradeLevelId     String?              @map("grade_level_id") @db.Uuid // optional context
  notes            String?
  status           SubjectRequestStatus @default(pending)
  reviewedBy       String?              @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  reviewNote       String?              @map("review_note")
  createdSubjectId String?              @map("created_subject_id") @db.Uuid // set on approval
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([requestedById])
  @@map("subject_requests")
}

// ---------------------------------------------------------------------------
// Online payments — Step 3 (Paymob foundation). Money-table style: plain UUID
// columns, no relations (cf. Payment/Transaction). State machine is one-way
// (pending -> paid | failed | expired), enforced by claim-style conditional
// updates in code. App-layer scoped — NOT in the tenant_isolation RLS set.
// ---------------------------------------------------------------------------

enum PaymentGateway {
  mock
  paymob

  @@map("payment_gateway")
}

enum PaymentIntentMethod {
  card // Paymob card iframe
  wallet // Paymob mobile wallets

  @@map("payment_intent_method")
}

enum PaymentIntentStatus {
  pending
  paid
  failed
  expired

  @@map("payment_intent_status")
}

model PaymentIntent {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String              @map("student_id") @db.Uuid
  courseId       String?             @map("course_id") @db.Uuid
  subscriptionId String?             @map("subscription_id") @db.Uuid // Step 4: intent pays for a subscription
  centerId       String?             @map("center_id") @db.Uuid // snapshot from the course at initiate time (nullable for future teacher-direct)
  amount         Int // piasters — ALWAYS server-set from the course, never from the client
  currency       String              @default("EGP")
  method         PaymentIntentMethod
  gateway        PaymentGateway
  status         PaymentIntentStatus @default(pending)
  idempotencyKey String              @unique @map("idempotency_key") // dedupes initiate retries
  gatewayOrderId String?             @unique @map("gateway_order_id") // webhook idempotency anchor
  gatewayRef     String?             @map("gateway_ref")
  failureReason  String?             @map("failure_reason")
  webhookPayload Json?               @map("webhook_payload") // raw last webhook body, stored verbatim
  paymentId      String?             @map("payment_id") @db.Uuid // settlement linkage -> payments.id
  transactionId  String?             @map("transaction_id") @db.Uuid // settlement linkage -> transactions.id
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(6)
  paidAt         DateTime?           @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([centerId, createdAt(sort: Desc)])
  @@map("payment_intents")
}

// ---------------------------------------------------------------------------
// Subscriptions — Step 4. A subscription links a student to EITHER an
// individual teacher OR a center (exactly one, CHECK-enforced) and WRAPS
// enrollment: the enrollment stays the roster link, the subscription is the
// payment-coverage layer that access/attendance checks consult.
// Money-table style columns; center-target rows are tenant-RLS-visible to
// their center, teacher-target rows (center_id NULL) are bypass-only per the
// documented RLS convention.
// ---------------------------------------------------------------------------

enum SubscriptionTarget {
  teacher
  center

  @@map("subscription_target")
}

enum SubscriptionPlan {
  monthly // covers one month from activation; manual renewal, no auto-charge
  per_session // single-session pass tied to a specific session

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  pending_payment
  active
  expired
  cancelled

  @@map("subscription_status")
}

enum SubscriptionSource {
  online
  walk_in

  @@map("subscription_source")
}

model Subscription {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String             @map("student_id") @db.Uuid
  targetType      SubscriptionTarget @map("target_type")
  teacherId       String             @map("teacher_id") @db.Uuid // course teacher, ALWAYS set; the target when targetType=teacher
  centerId        String?            @map("center_id") @db.Uuid // the target when targetType=center; NULL for teacher-direct
  courseId        String             @map("course_id") @db.Uuid
  sessionId       String?            @map("session_id") @db.Uuid // per_session plan: the covered session
  subjectId       String?            @map("subject_id") @db.Uuid // snapshots from the course at creation time
  gradeLevelId    String?            @map("grade_level_id") @db.Uuid
  trackId         String?            @map("track_id") @db.Uuid
  plan            SubscriptionPlan
  price           Int // piasters — server-side snapshot of the chosen plan price
  currency        String             @default("EGP")
  paymentMethod   PaymentMethod?     @map("payment_method") // cash | online_paymob, set when paid
  status          SubscriptionStatus @default(pending_payment)
  source          SubscriptionSource
  periodStart     DateTime?          @map("period_start") @db.Timestamptz(6) // monthly coverage window
  periodEnd       DateTime?          @map("period_end") @db.Timestamptz(6)
  enrollmentId    String?            @map("enrollment_id") @db.Uuid // the wrapped enrollment
  paymentIntentId String?            @map("payment_intent_id") @db.Uuid // online payment linkage
  paymentId       String?            @map("payment_id") @db.Uuid // settlement linkage
  createdBy       String?            @map("created_by") @db.Uuid // center staff for walk-ins (audit)
  activatedAt     DateTime?          @map("activated_at") @db.Timestamptz(6)
  cancelledAt     DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  // Demo/seed marker (explicit on this table per the Step 4 review decision).
  isDemo          Boolean            @default(false) @map("is_demo")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([courseId, status])
  @@index([centerId, status])
  @@index([teacherId, status])
  @@index([status, periodEnd]) // expiry sweep
  @@index([sessionId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Commission settings — Step 4.5. Scoped rows: the single `global` row is the
// platform default; per-center / per-teacher override rows can be added later
// WITHOUT a migration (resolution: teacher > center > global > code fallback).
// Platform-global config, superadmin-managed — app-scoped, no RLS.
// ---------------------------------------------------------------------------

enum CommissionScope {
  global
  center
  teacher

  @@map("commission_scope")
}

model CommissionSetting {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope                     CommissionScope @default(global)
  centerId                  String?         @map("center_id") @db.Uuid // set when scope=center
  teacherId                 String?         @map("teacher_id") @db.Uuid // set when scope=teacher
  teacherDirectCommissionBp Int             @map("teacher_direct_commission_bp") // basis points (1500 = 15%)
  platformTeacherFee        Int             @map("platform_teacher_fee") // piasters per present student (center split)
  platformCenterFee         Int             @map("platform_center_fee") // piasters per present student (center split)
  updatedBy                 String?         @map("updated_by") @db.Uuid
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([scope])
  @@map("commission_settings")
}

// ---------------------------------------------------------------------------
// Collaboration requests — Step 5. REPLACES ClassroomBooking and absorbs the
// existing-teacher affiliation invite (approved decision #3). Either side
// (teacher or center) proposes a class: catalog subject/grade/track, optional
// hall, schedule, optional expected students, and the centerShare the money
// engine will use. Acceptance transactionally creates the affiliation, the
// course, and its sessions. Center-scoped RLS like other center tables.
// ---------------------------------------------------------------------------

enum CollaborationInitiator {
  teacher
  center

  @@map("collaboration_initiator")
}

enum CollaborationStatus {
  pending
  accepted
  rejected
  cancelled
  expired

  @@map("collaboration_status")
}

model CollaborationRequest {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  initiator           CollaborationInitiator
  teacherId           String                 @map("teacher_id") @db.Uuid
  centerId            String                 @map("center_id") @db.Uuid
  subjectId           String                 @map("subject_id") @db.Uuid // catalog FK — no free text
  gradeLevelId        String                 @map("grade_level_id") @db.Uuid
  trackId             String?                @map("track_id") @db.Uuid
  roomId              String?                @map("room_id") @db.Uuid // optional hall; must belong to centerId
  daysOfWeek          Int[]                  @map("days_of_week")
  startTime           String                 @map("start_time") // "HH:MM"
  endTime             String                 @map("end_time")
  startDate           DateTime               @map("start_date") @db.Timestamptz(6)
  endDate             DateTime?              @map("end_date") @db.Timestamptz(6) // acceptance defaults +3 months
  expectedStudents    Int?                   @map("expected_students") // OPTIONAL — zero-student teachers can apply
  proposedCenterShare Int                    @map("proposed_center_share") // piasters; the money-engine centerShare
  message             String?
  status              CollaborationStatus    @default(pending)
  respondedAt         DateTime?              @map("responded_at") @db.Timestamptz(6)
  respondedBy         String?                @map("responded_by") @db.Uuid
  responseNote        String?                @map("response_note")
  courseId            String?                @map("course_id") @db.Uuid // acceptance linkage
  affiliationId       String?                @map("affiliation_id") @db.Uuid // acceptance linkage
  expiresAt           DateTime               @map("expires_at") @db.Timestamptz(6) // pending TTL
  createdBy           String                 @map("created_by") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([teacherId, status])
  @@index([centerId, status])
  @@index([status, expiresAt])
  @@map("collaboration_requests")
}
