// =============================================================================
// MESSAGING / REVIEWS
// =============================================================================

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  centerId  String?  @map("center_id") @db.Uuid
  lessonId  String?  @map("lesson_id") @db.Uuid // -> sessions.id, for per-lesson ratings (PRD)
  rating    Int      // 1..5 (enforced at API layer + CHECK constraint in migration)
  text      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([studentId, teacherId])
  @@index([teacherId])
  @@index([centerId])
  @@map("reviews")
}

model MessageThread {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantIds  String[]  @map("participant_ids") @db.Uuid
  centerId        String?   @map("center_id") @db.Uuid
  lastMessageAt   DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)
  lastMessageBody String?   @map("last_message_body")
  unreadCounts    Json      @default("{}") @map("unread_counts")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages Message[]

  @@index([participantIds])
  @@index([centerId, lastMessageAt(sort: Desc)])
  @@map("message_threads")
}

model Message {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("messages")
}

// =============================================================================
// CHATBOT & AI  (SCHEMA ONLY — no AI logic wired, per scope §1)
// =============================================================================

model ChatbotConfig {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supportBotEnabled    Boolean   @default(true) @map("support_bot_enabled")
  academicBotEnabled   Boolean   @default(true) @map("academic_bot_enabled")
  monthlyTokenLimit    Int       @default(1000000) @map("monthly_token_limit")
  tokensUsedThisMonth  Int       @default(0) @map("tokens_used_this_month")
  lastResetAt          DateTime? @map("last_reset_at") @db.Date
  updatedBy            String?   @map("updated_by") @db.Uuid
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("chatbot_config")
}

model ChatbotFaq {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question  String
  answer    String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("chatbot_faq")
}

model ChatbotConversation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  sessionId    String?  @map("session_id") @db.Uuid
  messages     Json?    // [{role, content, timestamp}]
  botType      BotType? @map("bot_type")
  handedOff    Boolean  @default(false) @map("handed_off") // feeds human support queue
  handoffTo    String?  @map("handoff_to")
  satisfaction Int?     // 1..5
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([handedOff])
  @@map("chatbot_conversations")
}
