// =============================================================================
// Edura / EduConnect — Prisma schema (Neon Postgres, serverless)
// -----------------------------------------------------------------------------
// Reconciliation model: every existing Edura Mongoose model is preserved here
// (so live MongoDB data ports 1:1 and the current 97 API routes keep working),
// and the PRD's EduConnect layer (super_admin/accountant roles, platform-fee
// ledger, points, payouts/invoices, blacklist, audit_logs, chatbot) is added
// on top. AI/chatbot tables are MODELED ONLY — no AI logic wired (per scope).
//
// Conventions:
//   - PKs: Postgres-generated UUID via gen_random_uuid() (pgcrypto).
//   - Money: Int, minor units (piasters). Never Float/Decimal.
//   - Columns: snake_case via @map; tables: snake_case plural via @@map.
//   - Enums: native Postgres enums (DEVIATION from PRD raw-SQL VARCHAR — chosen
//     for compile-time safety; flagged in the delivery summary).
//   - Tenant scope: center_id + @@index on every center-scoped table; RLS
//     policies + the remaining FK constraints live in a raw-SQL migration.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Connection URLs moved to prisma.config.ts (Prisma 7 requirement). The
  // runtime client injects a Neon driver adapter (see src/client.ts); the CLI
  // (migrate/db push/studio) reads the DIRECT_URL datasource from prisma.config.ts.
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  super_admin
  accountant
  center_admin // PRD "center"
  center_staff // center front-desk / manager / center-accountant — acts ON BEHALF OF a center (see CenterStaff); NOT a co-equal center_admin
  teacher
  assistant // teacher's team member — primary contact point for students/parents
  parent
  student

  @@map("role")
}

// Preset delegation tiers for a CenterStaff member. `center_accountant` is
// deliberately named to never be confused with the platform-wide `accountant`
// Role (apps/superadmin) — a center accountant is READ-ONLY on its OWN center's
// finance only and can never reach the superadmin app.
enum CenterStaffRole {
  receptionist // counter check-in, walk-in registration, cash wallet top-ups, student lookup
  manager // everything receptionist + room mgmt + collaboration accept/reject + operational reports
  center_accountant // READ-ONLY view of THIS center's financial reports/ledger; no mutations

  @@map("center_staff_role")
}

