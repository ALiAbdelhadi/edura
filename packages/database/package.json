{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "description": "Edura data layer — Prisma schema, Neon client, migrations, seed, and domain query functions. The ONLY package that imports Prisma directly.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./chat": {
      "types": "./src/queries/chat.ts",
      "default": "./src/queries/chat.ts"
    },
    "./chat-policy": {
      "types": "./src/queries/chat-policy.ts",
      "default": "./src/queries/chat-policy.ts"
    },
    "./chat-scope": {
      "types": "./src/queries/chat-scope.ts",
      "default": "./src/queries/chat-scope.ts"
    },
    "./chat-minors": {
      "types": "./src/queries/chat-minors.ts",
      "default": "./src/queries/chat-minors.ts"
    },
    "./chat-groups": {
      "types": "./src/queries/chat-groups.ts",
      "default": "./src/queries/chat-groups.ts"
    },
    "./chat-guardian": {
      "types": "./src/queries/chat-guardian.ts",
      "default": "./src/queries/chat-guardian.ts"
    },
    "./chat-safety": {
      "types": "./src/queries/chat-safety.ts",
      "default": "./src/queries/chat-safety.ts"
    },
    "./chat-oversight": {
      "types": "./src/queries/chat-oversight.ts",
      "default": "./src/queries/chat-oversight.ts"
    },
    "./chat-protocol": {
      "types": "./src/queries/chat-protocol.ts",
      "default": "./src/queries/chat-protocol.ts"
    },
    "./seed-ids": {
      "types": "./prisma/seed-ids.ts",
      "default": "./prisma/seed-ids.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "studio": "prisma studio",
    "validate": "prisma validate",
    "check-types": "tsc --noEmit",
    "format": "prisma format",
    "seed": "tsx prisma/seed.ts",
    "db:label": "tsx scripts/label-db.ts",
    "db:guard": "tsx scripts/db-guard.ts",
    "db:bootstrap-role": "tsx scripts/bootstrap-app-role.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "postinstall": "prisma generate",
    "seed:oversight-demo": "tsx prisma/center-oversight-demo-seed.ts",
    "seed:teamnotes-demo": "tsx --env-file=.env prisma/team-notes-demo-seed.ts",
    "seed:parentpay-demo": "tsx --env-file=.env prisma/parent-pay-demo-seed.ts",
    "seed:roomrate-demo": "tsx --env-file=.env prisma/room-rate-demo-seed.ts",
    "db:wipe": "tsx scripts/wipe-data.ts",
    "seed:showcase-demo": "tsx --env-file=.env prisma/showcase-demo-seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "bcryptjs": "3.0.3",
    "pg": "^8.22.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "dotenv": "17.4.2",
    "prisma": "^7.9.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
