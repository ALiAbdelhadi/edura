{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "description": "Edura data layer \u2014 Prisma schema, Neon client, migrations, seed, and domain query functions. The ONLY package that imports Prisma directly.",
  "type": "module",
  "exports": {
    "./search-text": {
      "types": "./src/search-text.ts",
      "default": "./src/search-text.ts"
    },
    "./room-amenities": {
      "types": "./src/room-amenities.ts",
      "default": "./src/room-amenities.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./pg-ssl": {
      "types": "./src/pg-ssl.ts",
      "default": "./src/pg-ssl.ts"
    },
    "./chat": {
      "types": "./src/queries/chat.ts",
      "default": "./src/queries/chat.ts"
    },
    "./chat-policy": {
      "types": "./src/queries/chat-policy.ts",
      "default": "./src/queries/chat-policy.ts"
    },
    "./chat-scope": {
      "types": "./src/queries/chat-scope.ts",
      "default": "./src/queries/chat-scope.ts"
    },
    "./chat-minors": {
      "types": "./src/queries/chat-minors.ts",
      "default": "./src/queries/chat-minors.ts"
    },
    "./chat-groups": {
      "types": "./src/queries/chat-groups.ts",
      "default": "./src/queries/chat-groups.ts"
    },
    "./chat-guardian": {
      "types": "./src/queries/chat-guardian.ts",
      "default": "./src/queries/chat-guardian.ts"
    },
    "./chat-safety": {
      "types": "./src/queries/chat-safety.ts",
      "default": "./src/queries/chat-safety.ts"
    },
    "./chat-oversight": {
      "types": "./src/queries/chat-oversight.ts",
      "default": "./src/queries/chat-oversight.ts"
    },
    "./chat-protocol": {
      "types": "./src/queries/chat-protocol.ts",
      "default": "./src/queries/chat-protocol.ts"
    },
    "./grading-scale": {
      "types": "./src/queries/grading-scale.ts",
      "default": "./src/queries/grading-scale.ts"
    },
    "./student-code": {
      "types": "./src/queries/student-code.ts",
      "default": "./src/queries/student-code.ts"
    },
    "./student-code-issue": {
      "types": "./src/queries/student-code-issue.ts",
      "default": "./src/queries/student-code-issue.ts"
    },
    "./seed-ids": {
      "types": "./prisma/seed-ids.ts",
      "default": "./prisma/seed-ids.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "studio": "prisma studio",
    "validate": "prisma validate",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "format": "prisma format",
    "seed": "tsx prisma/seed.ts",
    "db:label": "tsx scripts/label-db.ts",
    "db:guard": "tsx scripts/db-guard.ts",
    "db:bootstrap-role": "tsx scripts/bootstrap-app-role.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:finalize-codes": "tsx --env-file=.env.local scripts/finalize-student-codes.ts",
    "db:reconcile-wallets": "tsx --env-file=.env.local scripts/reconcile-wallets.ts",
    "postinstall": "prisma generate",
    "seed:oversight-demo": "tsx prisma/center-oversight-demo-seed.ts",
    "seed:teamnotes-demo": "tsx --env-file=.env.local prisma/team-notes-demo-seed.ts",
    "seed:parentpay-demo": "tsx --env-file=.env.local prisma/parent-pay-demo-seed.ts",
    "seed:paymobreview-demo": "tsx --env-file=.env.local prisma/paymob-review-demo-seed.ts",
    "seed:roomrate-demo": "tsx --env-file=.env.local prisma/room-rate-demo-seed.ts",
    "db:wipe": "tsx scripts/wipe-data.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore-test": "tsx scripts/restore-test.ts",
    "seed:showcase-demo": "tsx --env-file=.env.local prisma/showcase-demo-seed.ts",
    "seed:showcase-live-demo": "tsx --env-file=.env.local prisma/showcase-live-demo-seed.ts",
    "seed:showcase-payments-demo": "tsx --env-file=.env.local prisma/showcase-payments-demo-seed.ts",
    "seed:deliverymode-demo": "tsx --env-file=.env.local prisma/delivery-mode-demo-seed.ts",
    "seed:roomamenities-demo": "tsx --env-file=.env.local prisma/room-amenities-demo-seed.ts",
    "seed:settledlessons-demo": "tsx --env-file=.env.local prisma/settled-lessons-demo-seed.ts",
    "seed:extteachers-demo": "tsx --env-file=.env.local prisma/external-teachers-demo-seed.ts",
    "db:check-pending": "tsx scripts/check-pending-migrations.ts",
    "seed:studentid-demo": "tsx --env-file=.env.local prisma/student-id-demo-seed.ts",
    "seed:counter-demo": "tsx --env-file=.env.local prisma/counter-demo-seed.ts",
    "seed:bulkimport-demo": "tsx --env-file=.env.local prisma/bulk-import-demo-seed.ts",
    "seed:reportexport-demo": "tsx --env-file=.env.local prisma/report-export-demo-seed.ts",
    "seed:weeklydigest-demo": "tsx --env-file=.env.local prisma/weekly-digest-demo-seed.ts",
    "seed:guardianver-demo": "tsx --env-file=.env.local prisma/guardian-verification-demo-seed.ts",
    "db:local": "./scripts/local-test-db.sh",
    "db:local:reset": "./scripts/local-test-db.sh --reset",
    "db:local:env": "./scripts/local-test-db-env.sh local",
    "db:neon:env": "./scripts/local-test-db-env.sh neon"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "@repo/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "pg": "^8.22.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "@repo/notifications": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "dotenv": "17.4.2",
    "prisma": "^7.9.0",
    "tsx": "4.23.0",
    "typescript": "7.0.2"
  }
}
