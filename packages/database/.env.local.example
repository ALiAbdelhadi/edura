# @repo/database — dev branch (migrations, seeds, verify, db suites)
#
# Template. Copy to .env.local and fill it with:
#   bun scripts/setup-env.ts
# Never put a real value in this file — it is the ONE .env* the repo tracks.

# --- Database
ADMIN_URL=
DIRECT_URL=
DATABASE_URL=
APP_ROLE_PASSWORD=

# --- Database
DATABASE_DRIVER=ws
DATABASE_POOL_MAX=10
EDURA_ALLOW_DB_ENVS=dev
# --- Seed accounts
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
