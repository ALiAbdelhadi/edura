# ---------------------------------------------------------------------------
# Neon Postgres (serverless) — three connection strings, three purposes.
# ---------------------------------------------------------------------------
# DATABASE_URL : RUNTIME. Role must be NOBYPASSRLS (e.g. `edura_app`) over the
#                POOLED host ("-pooler"). RLS is ENFORCED on this connection.
#                This is the ONLY URL the app/client.ts uses at runtime.
# ADMIN_URL    : Owner/admin role (BYPASSRLS) over the POOLED host. Used by
#                scripts/apply-migrations.mjs (DDL over WebSocket) and role admin.
# DIRECT_URL   : Owner role over the DIRECT (non-pooler) host. Used by
#                `prisma migrate` where raw TCP:5432 is reachable.
#
# Why a separate runtime role: Neon's default `neondb_owner` has BYPASSRLS,
# which ignores Row-Level Security even with FORCE. Tenant isolation only works
# when the app connects as a NOBYPASSRLS role.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://edura_app:APP_PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
ADMIN_URL="postgresql://neondb_owner:OWNER_PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:OWNER_PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------------------
# Source MongoDB (for one-time ETL: scripts/etl-mongo-to-postgres.ts)
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=edura

# ---------------------------------------------------------------------------
# Seed — back-office staff accounts (apps/superadmin logins)
# ---------------------------------------------------------------------------
# If set, the seed creates/updates the staff account with these credentials and
# does NOT flag it is_demo (it survives the pre-launch demo purge). If unset,
# dev fallbacks are used (superadmin@edura.eg / accountant@edura.eg with
# SEED_PASSWORD, default Passw0rd!) and the accounts ARE flagged is_demo.
# DEV-ONLY: with NODE_ENV=production the seed REFUSES to run (fails fast,
# before any DB write) unless all four staff credential vars are set.
SEED_PASSWORD=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
