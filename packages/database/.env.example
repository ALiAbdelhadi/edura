# =============================================================================
# packages/database/.env.example  —  TEMPLATE for .env (dev; gitignored)
# =============================================================================
#     cp .env.example .env
# Point at a database labelled `edura-env:dev`:
#     COMMENT ON DATABASE neondb IS 'edura-env:dev';
# =============================================================================

DATABASE_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
DIRECT_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
ADMIN_URL=postgresql://OWNER:PASSWORD@HOST/neondb?sslmode=require

SEED_PASSWORD=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
