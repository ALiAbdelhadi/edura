# =============================================================================
# packages/database/.env.test.example  —  TEMPLATE for .env.test (gitignored)
# =============================================================================
# Loaded by scripts/load-env.ts when EDURA_ENV=test:
#     (unset)              -> packages/database/.env             (dev)
#     EDURA_ENV=test       -> packages/database/.env.test        (test)
#     EDURA_ENV=production -> packages/database/.env.production  (production)
#
#     cp .env.test.example .env.test    # then edit the URLs
#
# Point at a database labelled `edura-env:test`:
#     COMMENT ON DATABASE neondb IS 'edura-env:test';
# db-guard reads that label out of the database itself, so a stale or copied
# connection string cannot misrepresent where it landed.
# =============================================================================

DATABASE_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
# DIRECT_URL is the MIGRATION url and must be the OWNER: `prisma migrate deploy`
# issues DDL, and edura_app deliberately has no CREATE on schema public.
DIRECT_URL=postgresql://OWNER:PASSWORD@HOST/neondb?sslmode=require
# Owner role. Required by test-cleanup.ts: the money ledgers have UPDATE/DELETE
# REVOKEd from edura_app, so fixture teardown cannot use the app role.
ADMIN_URL=postgresql://OWNER:PASSWORD@HOST/neondb?sslmode=require

DATABASE_DRIVER=ws
DATABASE_POOL_MAX=10

# Seed accounts. Use throwaway values on a test branch — these are NOT the
# launch superadmin/accountant identities.
SEED_PASSWORD=
SEED_SUPERADMIN_EMAIL=superadmin@edura.test
SEED_SUPERADMIN_PASSWORD=change-me-locally
SEED_ACCOUNTANT_EMAIL=accountant@edura.test
SEED_ACCOUNTANT_PASSWORD=change-me-locally
