# =============================================================================
# packages/database/.env.production.example  —  TEMPLATE (gitignored target)
# =============================================================================
# Loaded by scripts/load-env.ts when EDURA_ENV=production. Used ONLY by
# migration/bootstrap scripts, never by a serving app.
#
# The database MUST be labelled:
#     COMMENT ON DATABASE neondb IS 'edura-env:production';
# Every script here calls assertDbEnv, and the seeds refuse production outright.
# =============================================================================
DATABASE_URL=
DIRECT_URL=
ADMIN_URL=
APP_ROLE_PASSWORD=
DATABASE_DRIVER=ws
