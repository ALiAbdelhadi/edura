{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "erp": {
      "root": "apps/erp",
      "framework": "nextjs",
      "buildCommand": "EDURA_SERVICE_BINDINGS=1 NODE_OPTIONS=--max-old-space-size=6144 bash ../../scripts/vercel-build.sh",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_SERVICE_URL" }
      ]
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "headers": [
        { "source": "/(.*)", "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Reporting-Endpoints", "value": "csp-endpoint=\"/api/v1/security/csp-report\"" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; frame-ancestors 'none'; report-uri /api/v1/security/csp-report; report-to csp-endpoint" }
      ] }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "erp" } }
  ]
}
