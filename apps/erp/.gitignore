node_modules
.next
# Any scratch build directory pointed at by NEXT_DIST_DIR (see next.config.ts) —
# `.next` alone does not match `.next-something`, so a parallel verification
# build would otherwise land 1,600 generated files in git and in the linter.
.next-*
out
dist

# Serwist service worker (generated by `next build --webpack`)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
.DS_Store
*.log
.env
.env.local
.env.*.local
coverage
.tsbuildinfo
next-env.d.ts.bak
*.tsbuildinfo
tests/e2e/reports/
tests/ui-probe/*.png
# Playwright
/test-results/
/playwright-report/
/blob-report/
# Local Netlify folder
.netlify

# Bruno local env (may hold a captured session token; regenerate with bun run gen:bruno)
bruno/environments/Local.bru

# Local-only dev-server launch config (duplicates root .claude/launch.json per-machine)
.claude/launch.json
.vercel
.env*
