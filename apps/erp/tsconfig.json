{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-pwa-verify/types/**/*.ts",
    ".next-pwa-verify/dev/types/**/*.ts",
    ".next-qr-verify/types/**/*.ts",
    ".next-qr-verify/dev/types/**/*.ts",
    ".next-chrome/types/**/*.ts",
    ".next-chrome/dev/types/**/*.ts",
    ".next-clock/types/**/*.ts",
    ".next-clock/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-review/types/**/*.ts",
    ".next-review/dev/types/**/*.ts",
    ".next-hydration/types/**/*.ts",
    ".next-hydration/dev/types/**/*.ts",
    ".next-ia/types/**/*.ts",
    ".next-ia/dev/types/**/*.ts",
    ".next-dialog/types/**/*.ts",
    ".next-dialog/dev/types/**/*.ts",
    ".next-overlay/types/**/*.ts",
    ".next-overlay/dev/types/**/*.ts",
    ".next-attendance/types/**/*.ts",
    ".next-attendance/dev/types/**/*.ts",
    ".next-settle/types/**/*.ts",
    ".next-settle/dev/types/**/*.ts",
    ".next-counter/types/**/*.ts",
    ".next-counter/dev/types/**/*.ts",
    ".next-audit/types/**/*.ts",
    ".next-audit/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/app/sw.ts"
  ]
}
