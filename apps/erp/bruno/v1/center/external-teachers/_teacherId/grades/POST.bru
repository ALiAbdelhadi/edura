meta {
  name: POST grades
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/center/external-teachers/:teacherId/grades
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "courseId": "{{courseId}}",
    "name": "",
    "gradeType": "",
    "maxScore": 0,
    "date": ""
  }
}
