meta {
  name: POST messages
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "conversationId": "{{conversationId}}",
    "recipientId": "{{recipientId}}",
    "body": "Hello from Bruno",
    "clientId": "bruno-example-1"
  }
}
