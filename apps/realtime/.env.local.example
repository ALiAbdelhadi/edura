# apps/realtime — local dev
#
# Template. Copy to .env.local and fill it with:
#   bun scripts/setup-env.ts
# Never put a real value in this file — it is the ONE .env* the repo tracks.

# --- Database
ADMIN_URL=
DIRECT_URL=
DATABASE_URL=
APP_ROLE_PASSWORD=

# --- Database
DATABASE_DRIVER=pg
# --- App secrets
REALTIME_JWT_SECRET=
INTERNAL_API_SECRET=
# --- URLs
APP_ORIGIN=http://localhost:3002
APP_INTERNAL_URL=http://localhost:3002
REALTIME_PORT=3005
