# =============================================================================
# apps/realtime/.env.example  —  TEMPLATE for .env.local (gitignored)
# =============================================================================
# The Socket.IO chat server. It reads only these six variables (verified by
# grepping process.env across apps/realtime/src); the rest of the monorepo's
# keys are not used here.
# =============================================================================

DATABASE_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
DATABASE_DRIVER=ws

# Handshake verification. NEXTAUTH_SECRET must match apps/www.
NEXTAUTH_SECRET=must-match-apps/www
# Dedicated realtime secret — REQUIRED in production, no NEXTAUTH_SECRET
# fallback outside dev (security-audit M2).
REALTIME_JWT_SECRET=generate-with-openssl-rand-base64-32
# Server-to-server bridge secret — REQUIRED in production (M2).
INTERNAL_API_SECRET=generate-with-openssl-rand-base64-32

REALTIME_PORT=4001
# CORS origin of the www app, and the URL this server calls back on.
APP_ORIGIN=http://localhost:3002
APP_INTERNAL_URL=http://localhost:3002
