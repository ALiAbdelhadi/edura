# Edura realtime chat server
REALTIME_PORT=3005

# Neon pooled URL for the RLS-enforced edura_app role (same as apps/www).
DATABASE_URL=

# Long-running process ⇒ use a node-postgres pool in production.
# Leave unset in serverless-style dev sandboxes where raw TCP:5432 is blocked.
DATABASE_DRIVER=pg
DATABASE_POOL_MAX=10

# Shared secret with the Next.js app (handshake tokens + internal bridge).
NEXTAUTH_SECRET=
# Optional dedicated secrets (fall back to NEXTAUTH_SECRET):
# REALTIME_JWT_SECRET=
# INTERNAL_API_SECRET=

# Browser origins allowed to connect (CSV).
APP_ORIGIN=http://localhost:3002
# Next.js base URL for the offline→push notification bridge.
APP_INTERNAL_URL=http://localhost:3002
