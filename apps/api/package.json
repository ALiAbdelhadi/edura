{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Edura ERP API service — long-running Bun + Hono process that serves everything under apps/erp's /api/** (phase 2 skeleton: request id, client-IP trust, envelope errors, health, observability). Business logic lives in @repo/server-core; nothing here is copied from a Next app.",
  "type": "module",
  "exports": {
    "./routes/*": "./src/routes/*.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development EDURA_DEV_COOKIE_PORT=${WWW_PORT:-3002} bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:parity": "vitest run --config vitest.parity.config.ts tests/parity/parity.test.ts",
    "bench:parity": "vitest run --config vitest.parity.config.ts tests/parity/latency.bench.ts"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "@repo/notifications": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/server-core": "workspace:*",
    "@repo/service-kit": "workspace:*",
    "@repo/shared": "workspace:*",
    "@sentry/node": "10.71.0",
    "hono": "4.13.11",
    "jose": "^6.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "26.1.1",
    "eslint": "9.39.5",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
