# =============================================================================
# apps/superadmin/.env.production.example  —  TEMPLATE for .env.production (gitignored)
# =============================================================================
# Start from .env.example (the full annotated key list) and then satisfy the
# REQUIRED-IN-PRODUCTION block below. Each of these fails CLOSED when missing —
# the app refuses to serve rather than degrading silently. That is deliberate.
#
# AUDIT NOTE (2026-07-26): apps/superadmin/.env.production contained only
# DIRECT_URL, DATABASE_URL and APP_ROLE_PASSWORD — none of the secrets below. The
# back-office app could not have served a single authenticated request. This
# template exists so that gap is visible before a deploy, not after.
# =============================================================================

# --- REQUIRED IN PRODUCTION — missing any of these is a hard failure ---------
# PAYMENTS_MODE  must be explicit: mock | sandbox | live          (C1)
# PAYMOB_HMAC_SECRET  required when mode is sandbox|live, no fallback (C1)
# REALTIME_JWT_SECRET  dedicated; no NEXTAUTH_SECRET fallback      (M2)
# INTERNAL_API_SECRET  dedicated; no NEXTAUTH_SECRET fallback      (M2)
# CRON_SECRET          required in EVERY env; unset => all cron requests refused (M7)
PAYMENTS_MODE=
PAYMOB_HMAC_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
REALTIME_JWT_SECRET=
INTERNAL_API_SECRET=
CRON_SECRET=

# --- Also required, just without a fail-closed check -------------------------
DATABASE_URL=
DIRECT_URL=
DATABASE_DRIVER=ws
NEXTAUTH_SECRET=
SUPERADMIN_NEXTAUTH_SECRET=
NEXTAUTH_URL=https://CHANGE-ME
APP_BASE_URL=https://CHANGE-ME
APP_ORIGIN=https://CHANGE-ME
APP_INTERNAL_URL=http://127.0.0.1:3004

# --- Silent-failure traps: set these or the feature quietly does nothing -----
# MAIL_PROVIDER defaults to `console`, which DELIVERS NOTHING, in production too.
MAIL_PROVIDER=smtp
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# WHATSAPP_MODE has no production fail-closed either — unset silently means mock.
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v20.0
# Empty => the rate limiter falls back to PER-INSTANCE memory, which is wrong
# behind more than one instance.
REDIS_URL=
# Must match the real proxy depth or IP-keyed limits collapse to the proxy's IP.
TRUSTED_PROXY_HOPS=1
TRUSTED_CLIENT_IP_HEADER=

# --- Optional ----------------------------------------------------------------
NEXT_PUBLIC_REALTIME_URL=
REALTIME_INTERNAL_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
FIREBASE_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
INVITE_CHANNELS=email
INVITE_TOKEN_TTL_HOURS=168
GUARDIAN_EMAIL_GRACE_DAYS=14
GUARDIAN_REMINDER_EVERY_DAYS=3
