# =============================================================================
# apps/superadmin/.env.test.example  —  TEMPLATE for .env.test (gitignored)
# =============================================================================
#     cp .env.test.example .env.test    # then edit the three URLs
#
# Same database, same rules as apps/www/.env.test.example — read the long
# explanation there. The short version:
#
#   * point this at a database labelled `edura-env:test`, never dev/production
#     (COMMENT ON DATABASE neondb IS 'edura-env:test')
#   * the aggregate runner asserts that label IN-PROCESS and refuses otherwise
#   * every outbound channel stays inert
#
# The two apps can and should share ONE test database: c04-login-boundary proves
# the cookie/role boundary holds between them, which requires both to see the
# same users.
# =============================================================================

# --- Connections (REQUIRED) --------------------------------------------------
# ADMIN_URL is not optional here: 18 of 18 superadmin suites use it. The
# center-oversight suite specifically proves that a super_admin CANNOT mutate
# the money ledgers through the app role, which means the suite has to hold both
# roles at once — edura_app to be refused, owner to set up and tear down.
DATABASE_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
DIRECT_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
ADMIN_URL=postgresql://OWNER:PASSWORD@HOST/neondb?sslmode=require

DATABASE_DRIVER=ws
DATABASE_POOL_MAX=10

# --- Auth (REQUIRED) ---------------------------------------------------------
# MUST be byte-identical to apps/www/.env.test for the cross-app boundary proofs
# to mean anything: c04 asserts a www cookie is REJECTED here and vice versa. If
# the secrets differ by accident, the test passes for the wrong reason.
NEXTAUTH_SECRET=must-match-apps/www/.env.test-exactly
SUPERADMIN_NEXTAUTH_SECRET=must-match-apps/www/.env.test-exactly-and-differ-from-the-above
NEXTAUTH_URL=http://localhost:3004
APP_BASE_URL=http://localhost:3004

REALTIME_JWT_SECRET=must-match-apps/www/.env.test
INTERNAL_API_SECRET=must-match-apps/www/.env.test
CRON_SECRET=must-match-apps/www/.env.test

# --- Drivers: inert ----------------------------------------------------------
# The accountant's "email this invoice" path runs through here. Keep it console
# so a suite can never mail a real recipient. (Note: sendInvoiceEmail currently
# returns a hardcoded {sent:true} and ignores this — see
# docs/reports/feature-completeness.md §2.5. Do not read a passing test as proof
# that mail was delivered.)
MAIL_PROVIDER=console
MAIL_FROM=Edura <no-reply@edura.test>

PAYMENTS_MODE=mock
PAYMOB_HMAC_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=

WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v20.0

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@edura.test
FIREBASE_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER=

# --- Optional ----------------------------------------------------------------
REDIS_URL=
TRUSTED_PROXY_HOPS=0
TRUSTED_CLIENT_IP_HEADER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
