# apps/superadmin — local dev
#
# Template. Copy to .env.local and fill it with:
#   bun scripts/setup-env.ts
# Never put a real value in this file — it is the ONE .env* the repo tracks.

# --- Database
ADMIN_URL=
DIRECT_URL=
DATABASE_URL=
APP_ROLE_PASSWORD=

# --- Database
DATABASE_DRIVER=ws
DATABASE_POOL_MAX=10
EDURA_ALLOW_DB_ENVS=dev
# --- App secrets
SUPERADMIN_NEXTAUTH_SECRET=
STUDENT_QR_SECRET=
VIEW_AS_SECRET=
INTERNAL_API_SECRET=
# --- Rate limiting
REDIS_URL=
# --- Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- URLs
NEXTAUTH_URL=http://localhost:3001
ERP_BASE_URL=http://localhost:3002
# --- Modes
PAYMENTS_MODE=mock
WHATSAPP_MODE=mock
MAIL_PROVIDER=console
INVITE_CHANNELS=email
TRUSTED_PROXY_HOPS=0
