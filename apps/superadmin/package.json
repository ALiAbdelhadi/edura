{
  "name": "superadmin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${SUPERADMIN_PORT:-3004}",
    "build": "next build",
    "start": "bun --bun next start -p 3006",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "pretest:db": "tsx --env-file=.env.test ../../packages/database/scripts/db-guard.ts test",
    "test:db": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db",
    "test:db:ci": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db --exclude c02-payout-generation",
    "test:db:parity": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db --only center-people,center-academic,center-operations,center-money,center-platform",
    "test:db:list": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db --list",
    "test:db:bail": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db --bail",
    "test:db:only": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db --only",
    "test:db:sweep": "tsx --env-file=../../packages/database/.env.test ../../packages/database/scripts/test-cleanup.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@refinedev/core": "^5.0.12",
    "@repo/client-core": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/notifications": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/server-core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^10.69.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.6.25",
    "exceljs": "^4.4.0",
    "ky": "^2.0.2",
    "lucide-react": "^1.27.0",
    "next": "16.3.0",
    "next-intl": "^4.13.4",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@repo/eslint-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "9.39.5",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
