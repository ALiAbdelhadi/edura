# ----- Neon Postgres (runtime) -----
# Same rule as apps/www: MUST be the NOBYPASSRLS runtime role (edura_app) over
# the POOLED host. Never the owner role at runtime.
DATABASE_URL=

# ----- next-auth (back-office session — fully separate from www) -----
# Generate with: openssl rand -base64 32
# MUST differ from the www NEXTAUTH_SECRET so tokens are mutually invalid.
# (In development it falls back to NEXTAUTH_SECRET if unset; production requires it.)
SUPERADMIN_NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3004

# ----- Email (dev stub by default) -----
MAIL_PROVIDER=console
MAIL_FROM=no-reply@edura.local

# ----- Seed (run from packages/database: pnpm --filter @repo/database seed) -----
# Back-office staff credentials. If set, the seed creates/updates the account
# with these credentials and does NOT flag it is_demo (survives the pre-launch
# purge). If unset, dev fallbacks are used: superadmin@edura.eg /
# accountant@edura.eg with SEED_PASSWORD (default Passw0rd!), flagged is_demo.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
