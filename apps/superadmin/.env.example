# =============================================================================
# apps/superadmin/.env.example  —  TEMPLATE for .env.local (dev; gitignored)
# =============================================================================
#     cp .env.example .env.local
# Point at a database labelled `edura-env:dev`. See .env.test.example for the
# labelling rule and why it exists.
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
DIRECT_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
ADMIN_URL=postgresql://OWNER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_DRIVER=ws
DATABASE_POOL_MAX=10

# --- Auth --------------------------------------------------------------------
#   openssl rand -base64 32
# Both values must be BYTE-IDENTICAL to apps/www/.env.local, and must differ from
# each other. authorize() here accepts only super_admin and accountant.
NEXTAUTH_SECRET=
SUPERADMIN_NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3004
APP_BASE_URL=http://localhost:3004
APP_ORIGIN=http://localhost:3004
APP_INTERNAL_URL=http://localhost:3004

# --- Dedicated secrets (REQUIRED in production — M2/M7) ----------------------
REALTIME_JWT_SECRET=
INTERNAL_API_SECRET=
CRON_SECRET=

# --- Realtime ----------------------------------------------------------------
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
REALTIME_INTERNAL_URL=http://localhost:4001
REALTIME_PORT=4001

# --- Payments ----------------------------------------------------------------
# `mock` | `sandbox` | `live`. MUST be set explicitly in production or the app
# hard-fails by design (C1) — it will never silently default to mock there.
# NOTE (2026-07-26): `sandbox` and `live` both select the Paymob driver, which is
# still an unimplemented stub. Only `mock` works today.
PAYMENTS_MODE=mock
PAYMOB_HMAC_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=

# --- WhatsApp ----------------------------------------------------------------
# `mock` | `live`. WARNING: unlike PAYMENTS_MODE there is NO production
# fail-closed — an unset value silently means `mock`, i.e. nothing is delivered.
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v20.0

# --- Mail --------------------------------------------------------------------
# `console` (logs only, DELIVERS NOTHING) | `smtp` (real). Defaults to `console`
# when unset, in EVERY environment including production — set it deliberately.
MAIL_PROVIDER=console
MAIL_FROM=Edura <no-reply@edura.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Invites & child safety --------------------------------------------------
INVITE_CHANNELS=email
INVITE_TOKEN_TTL_HOURS=168
WALKIN_TOKEN_TTL_HOURS=168
GUARDIAN_EMAIL_GRACE_DAYS=14
GUARDIAN_REMINDER_EVERY_DAYS=3

# --- Push --------------------------------------------------------------------
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# FCM: a real driver, inert without this. Leave blank to skip mobile push.
FIREBASE_SERVICE_ACCOUNT_JSON=
# SMS: no provider is implemented today — any value other than `console` logs a
# warning and skips. Leaving it blank is the honest setting.
SMS_PROVIDER=

# --- Media -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting -----------------------------------------------------------
# Unset => per-instance in-memory buckets (fine for one dev process, wrong for a
# multi-instance deploy). Set for a shared store (M3).
REDIS_URL=
TRUSTED_PROXY_HOPS=0
TRUSTED_CLIENT_IP_HEADER=

# --- Seeds (dev only) --------------------------------------------------------
SEED_PASSWORD=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
