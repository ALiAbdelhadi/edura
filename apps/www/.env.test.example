# =============================================================================
# apps/www/.env.test.example  —  TEMPLATE for .env.test (which is gitignored)
# =============================================================================
# Copy to .env.test and fill in the two connection strings. Every `test:db*`
# script loads this file with `tsx --env-file=.env.test`; node exits 9 if the
# file is absent, which is why the whole DB proof corpus was unrunnable before
# this template existed.
#
#     cp .env.test.example .env.test    # then edit the two URLs below
#
# -----------------------------------------------------------------------------
# THE ONE RULE: point this at a database labelled `edura-env:test`.
# -----------------------------------------------------------------------------
# The runner calls db-guard IN-PROCESS and refuses to run against a database
# labelled `dev` or `production`. The label lives INSIDE the database, so a
# copied or hand-edited connection string still reports the truth:
#
#     -- once, as the database owner, on the test branch only:
#     COMMENT ON DATABASE neondb IS 'edura-env:test';
#
# A Neon branch inherits its parent's comment, so a branch made from dev will
# announce itself as 'dev' and be refused until you relabel it. That is the
# intended behaviour, not a bug — relabel, do not work around it.
#
# NEVER point this at the dev or production branch. An audit on 2026-07-26 found
# 472 of 535 users in DEV were test fixtures leaked by exactly that mistake.
# =============================================================================

# --- Connections (REQUIRED) --------------------------------------------------
# DATABASE_URL  : the pooled, RLS-respecting app role (edura_app, NOBYPASSRLS).
#                 Suites use it to prove tenant isolation actually isolates.
# DIRECT_URL    : unpooled, same role — migrations and session-pinned work.
# ADMIN_URL     : the OWNER role. 31 suites need it, because the money ledgers
#                 (transactions, points_ledger, session_settlements, audit_logs)
#                 have UPDATE/DELETE REVOKEd from edura_app — fixture teardown
#                 is impossible without it. Cleanup uses this connection.
DATABASE_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
DIRECT_URL=postgresql://edura_app:PASSWORD@HOST/neondb?sslmode=require
ADMIN_URL=postgresql://OWNER:PASSWORD@HOST/neondb?sslmode=require

# Neon over WebSocket rather than TCP (see docs/guides/runbook.md).
DATABASE_DRIVER=ws
DATABASE_POOL_MAX=10

# --- Auth (REQUIRED) ---------------------------------------------------------
# 5 suites mint or decode real NextAuth JWTs, and c04-login-parity /
# c04-login-boundary assert the two apps' cookies are NOT interchangeable — so
# these two values MUST differ from each other. Any 32+ byte random string.
#   openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
SUPERADMIN_NEXTAUTH_SECRET=generate-a-DIFFERENT-one-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3002
APP_BASE_URL=http://localhost:3002

# --- Dedicated secrets, required in prod, needed here so M2 can assert them ---
REALTIME_JWT_SECRET=generate-with-openssl-rand-base64-32
INTERNAL_API_SECRET=generate-with-openssl-rand-base64-32
CRON_SECRET=generate-with-openssl-rand-base64-32

# --- Drivers: keep every outbound channel INERT under test -------------------
# Nothing here may reach a real third party. `console` mail and `mock` drivers
# are the correct test values, not a limitation.
#
# NOTE: mail-password-reset.test.ts reads SMTP_* and MAIL_PROVIDER. Leave
# MAIL_PROVIDER=console so it exercises the no-delivery branch. Only set
# MAIL_PROVIDER=smtp with a CAPTURE inbox (Mailtrap, MailHog) — never a real host.
MAIL_PROVIDER=console
MAIL_FROM=Edura <no-reply@edura.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

PAYMENTS_MODE=mock
PAYMOB_HMAC_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=

WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v20.0

# invite-claim.test.ts reads this. `email` is the default and the tested path.
INVITE_CHANNELS=email
INVITE_TOKEN_TTL_HOURS=168
WALKIN_TOKEN_TTL_HOURS=168
GUARDIAN_EMAIL_GRACE_DAYS=14
GUARDIAN_REMINDER_EVERY_DAYS=3

# No credentials => no push. Correct under test.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@edura.test
FIREBASE_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER=

# --- Optional ----------------------------------------------------------------
# Leave REDIS_URL empty to exercise the in-memory rate-limit fallback; set it to
# a THROWAWAY database index to exercise the shared store. Never share an index
# with dev — the limiter's keys would collide.
REDIS_URL=
TRUSTED_PROXY_HOPS=0
TRUSTED_CLIENT_IP_HEADER=

# Media: leave blank unless running the Cloudinary-backed material/photo suites.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only the HTTP-level probe scripts (apps/www/tests/db/_*.ts) use these, and
# they require dev servers on these ports. The *.test.ts suites do not.
WWW_BASE_URL=http://localhost:3002
SUPERADMIN_BASE_URL=http://localhost:3004
