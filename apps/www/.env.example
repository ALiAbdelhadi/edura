# ----- Neon Postgres (runtime) -----
# MUST be a NOBYPASSRLS role (e.g. edura_app) over the POOLED host ("-pooler").
# Row-Level Security tenant isolation depends on this — never use the owner
# role (neondb_owner has BYPASSRLS) at runtime.
DATABASE_URL=

# ----- next-auth -----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002

# ----- Email (dev stub by default) -----
# Provider: "console" (logs to stdout) | "mailgun" | "sendgrid"
MAIL_PROVIDER=console
MAIL_FROM=no-reply@edura.local
# Used to build links in emails (password reset, invite accept).
APP_BASE_URL=http://localhost:3002

# ----- Seed (fresh environments only) -----
# Password applied to demo fixtures created by `pnpm db:seed`
SEED_PASSWORD=Passw0rd!
