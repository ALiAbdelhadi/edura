# ----- Neon Postgres (runtime) -----
# MUST be a NOBYPASSRLS role (e.g. edura_app) over the POOLED host ("-pooler").
# Row-Level Security tenant isolation depends on this — never use the owner
# role (neondb_owner has BYPASSRLS) at runtime.
DATABASE_URL=

# ----- next-auth -----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002

# ----- Email (dev stub by default) -----
# Provider: "console" (logs to stdout) | "mailgun" | "sendgrid"
MAIL_PROVIDER=console
MAIL_FROM=no-reply@edura.local
# Used to build links in emails (password reset, invite accept).
APP_BASE_URL=http://localhost:3002

# ----- Seed (fresh environments only) -----
# Password applied to demo fixtures created by `pnpm db:seed`
SEED_PASSWORD=Passw0rd!

# ----- Web Push (VAPID) -----
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@edura.local

# Realtime chat (standalone Socket.IO server — apps/realtime)
NEXT_PUBLIC_REALTIME_URL=http://localhost:3005
REALTIME_INTERNAL_URL=http://localhost:3005
# Optional dedicated secrets (fall back to NEXTAUTH_SECRET):
# REALTIME_JWT_SECRET=
# INTERNAL_API_SECRET=

# ----- Online payments (Step 3 — Paymob foundation) -----
# PAYMENTS_MODE picks the gateway driver: mock (default, fully local, no
# credentials needed) | sandbox | live (both use the paymob driver — still a
# stub until the real integration is wired).
PAYMENTS_MODE=mock
# Paymob credentials (card iframe + mobile wallets only). All unused in mock
# mode; the mock webhook signer falls back to a dev constant when
# PAYMOB_HMAC_SECRET is unset.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=

# --- WhatsApp (Step 7) ---
# WHATSAPP_MODE picks the driver: mock (default, fully local, no credentials)
# or live (Meta WhatsApp Business Cloud API — requires the two vars below and
# approved templates, see docs/whatsapp-templates.md).
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v20.0
# Walk-in onboarding link lifetime (hours, default 168 = 7 days)
WALKIN_TOKEN_TTL_HOURS=168
