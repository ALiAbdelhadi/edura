# ----- Neon Postgres (runtime) -----
# MUST be a NOBYPASSRLS role (e.g. edura_app) over the POOLED host ("-pooler").
# Row-Level Security tenant isolation depends on this — never use the owner
# role (neondb_owner has BYPASSRLS) at runtime.
DATABASE_URL=

# ----- next-auth -----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002

# ----- Email (dev stub by default) -----
# Provider: "console" (logs to stdout) | "mailgun" | "sendgrid"
MAIL_PROVIDER=console
MAIL_FROM=no-reply@edura.local
# Used to build links in emails (password reset, invite accept).
APP_BASE_URL=http://localhost:3002

# ----- Seed (fresh environments only) -----
# Password applied to demo fixtures created by `pnpm db:seed`
SEED_PASSWORD=Passw0rd!

# ----- Web Push (VAPID) -----
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@edura.local

# Realtime chat (standalone Socket.IO server — apps/realtime)
NEXT_PUBLIC_REALTIME_URL=http://localhost:3005
REALTIME_INTERNAL_URL=http://localhost:3005
# Dedicated per-boundary secrets (M2). REQUIRED IN PRODUCTION — requests that
# need them fail if unset in prod; in dev they fall back to NEXTAUTH_SECRET.
# Must match the same-named vars in apps/realtime.
REALTIME_JWT_SECRET=
INTERNAL_API_SECRET=

# ----- Online payments (Step 3 — Paymob foundation) -----
# PAYMENTS_MODE picks the gateway driver: mock (default, fully local, no
# credentials needed) | sandbox | live (both use the paymob driver — still a
# stub until the real integration is wired).
PAYMENTS_MODE=mock
# Paymob credentials (card iframe + mobile wallets only). All unused in mock
# mode; the mock webhook signer falls back to a dev constant when
# PAYMOB_HMAC_SECRET is unset.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=

# --- WhatsApp (Step 7) ---
# WHATSAPP_MODE picks the driver: mock (default, fully local, no credentials)
# or live (Meta WhatsApp Business Cloud API — requires the two vars below and
# approved templates, see docs/whatsapp-templates.md).
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v20.0
# Walk-in onboarding link lifetime (hours, default 168 = 7 days)
WALKIN_TOKEN_TTL_HOURS=168

# --- Rate limiting (M3) ---
# Shared store so limits hold across instances/restarts. Unset = per-process
# in-memory (fine for local dev). Self-hosted Redis or Upstash-over-TCP:
# REDIS_URL=redis://localhost:6379   (or rediss://...@...upstash.io:port)
REDIS_URL=
# Trusted reverse-proxy hops that append to X-Forwarded-For (each adds one
# entry on the right). The client IP is taken that many hops from the right, so
# a spoofed leftmost XFF can't forge a distinct key. 1 = single Nginx (default).
# Behind Cloudflare+Nginx use 2, or set TRUSTED_CLIENT_IP_HEADER instead.
TRUSTED_PROXY_HOPS=1
# Optional platform header carrying the verified client IP (used first if set):
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# --- Cron jobs (M7) ---
# Shared secret guarding /api/v1/cron/[job] (month-end statements, intent /
# subscription / collaboration expiry, lesson reminders). REQUIRED IN EVERY
# ENVIRONMENT — the endpoint fails closed (rejects every request) when unset,
# with no env-based bypass. The scheduler must send it as either
# `Authorization: Bearer <secret>` or `x-cron-secret: <secret>`. POST-only.
CRON_SECRET=
