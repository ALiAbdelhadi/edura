meta {
  name: POST courses
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/courses
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "teacherId": "{{teacherId}}",
    "defaultRoomId": "{{defaultRoomId}}",
    "title": "",
    "subject": "",
    "description": "",
    "gradeTag": "",
    "schedulePattern": "",
    "price": 0,
    "maxStudents": ""
  }
}
