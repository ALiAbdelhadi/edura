{
  "name": "edura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsx --env-file=.env.local tests/db/run-db-tests.ts",
    "test:db:all": "tsx --env-file=.env.local tests/db/offline-sync.test.ts && tsx --env-file=.env.local tests/db/rbac-isolation.test.ts && tsx --env-file=.env.local tests/db/refund.test.ts && tsx --env-file=.env.local tests/db/run-db-tests.ts",
    "test:pw": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test",
    "test:pw:headed": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test --headed",
    "test:pw:ui": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test --ui",
    "smoke:api": "bash scripts/api-smoke.sh",
    "gen:bruno": "node scripts/gen-bruno.mjs",
    "db:seed": "pnpm --filter @repo/database seed"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@refinedev/antd": "^6.0.3",
    "@refinedev/core": "^5.0.12",
    "@repo/database": "workspace:*",
    "antd": "^5.29.3",
    "bcryptjs": "3.0.3",
    "d3": "^7.9.0",
    "dayjs": "^1.11.20",
    "ky": "^2.0.2",
    "next": "16.2.10",
    "next-auth": "4.24.14",
    "pdf-lib": "^1.17.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/d3": "^7.4.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.5.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.9",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
