{
  "name": "edura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:pwa": "SERWIST_DEV=1 next dev -p 3002 --webpack",
    "build": "next build --webpack",
    "start": "next start -p 3003",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "check-types:sw": "tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "pretest:db": "tsx --env-file=.env.test ../../packages/database/scripts/db-guard.ts test",
    "test:db": "pnpm pretest:db && tsx --env-file=.env.test tests/db/run-db-tests.ts",
    "test:db:all": "pnpm pretest:db && tsx --env-file=.env.test tests/db/offline-sync.test.ts && tsx --env-file=.env.test tests/db/rbac-isolation.test.ts && tsx --env-file=.env.test tests/db/run-db-tests.ts && tsx --env-file=.env.test tests/db/catalog-onboarding.test.ts",
    "test:pw": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test",
    "test:pw:headed": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test --headed",
    "test:pw:ui": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test --ui",
    "mail:check": "tsx --env-file=.env.local scripts/mail-check.ts",
    "smoke:api": "bash scripts/api-smoke.sh",
    "gen:bruno": "node scripts/gen-bruno.mjs",
    "db:seed": "pnpm --filter @repo/database seed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@refinedev/core": "^5.0.12",
    "@repo/database": "workspace:*",
    "@repo/server-core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "3.0.3",
    "dayjs": "^1.11.20",
    "jose": "^6.0.11",
    "ky": "^2.0.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "4.24.14",
    "next-cloudinary": "^6.17.5",
    "next-intl": "^4.13.2",
    "pdf-lib": "^1.17.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "socket.io-client": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@playwright/test": "^1.60.0",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.18",
    "serwist": "^9.5.11",
    "tailwindcss": "^4.2.4",
    "tsx": "4.23.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
