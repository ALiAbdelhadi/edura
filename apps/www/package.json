{
  "name": "edura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:pwa": "SERWIST_DEV=1 next dev -p 3002 --webpack",
    "build": "next build --webpack",
    "start": "bun --bun next start -p 3003",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "check-types:sw": "tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "pretest:db": "tsx --env-file=.env.test ../../packages/database/scripts/db-guard.ts test",
    "test:db": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db",
    "test:db:all": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db",
    "test:pw": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test",
    "test:pw:headed": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test --headed",
    "test:pw:ui": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright test --ui",
    "mail:check": "tsx --env-file=.env.local scripts/mail-check.ts",
    "smoke:api": "bash scripts/api-smoke.sh",
    "gen:bruno": "node scripts/gen-bruno.mjs",
    "db:seed": "bun run --filter @repo/database seed",
    "test:db:list": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db --list",
    "test:db:bail": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db --bail",
    "test:db:only": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db --only",
    "test:db:sweep": "tsx --env-file=.env.test ../../packages/database/scripts/test-cleanup.ts",
    "test:all": "bun run check-types && bun run test:unit && bun run test:db",
    "test:db:ci": "tsx --env-file=.env.test ../../packages/database/scripts/run-db-suites.ts tests/db --exclude catalog-onboarding,c01-lesson-settlement,h03-seed-uuid-flows",
    "test:e2e": "bun test ./tests/e2e/smoke.e2e.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@refinedev/core": "^5.0.12",
    "@repo/database": "workspace:*",
    "@repo/server-core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "3.0.3",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "jose": "^6.2.4",
    "ky": "^2.0.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-auth": "4.24.15",
    "next-cloudinary": "^6.17.5",
    "next-intl": "^4.13.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@playwright/test": "^1.62.0",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.23",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
