{
  "$schema": "https://v2-10-11.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "CLOUDINARY_CLOUD_NAME",
        "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
        "NEXT_PUBLIC_REALTIME_URL",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
        "DATABASE_URL",
        "DATABASE_DRIVER",
        "DATABASE_POOL_MAX",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "SUPERADMIN_NEXTAUTH_SECRET",
        "APP_BASE_URL",
        "APP_ORIGIN",
        "VERCEL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_APP_ORIGIN",
        "MARKETING_SITE_URL",
        "APP_INTERNAL_URL",
        "REALTIME_INTERNAL_URL",
        "REALTIME_JWT_SECRET",
        "INTERNAL_API_SECRET",
        "CRON_SECRET",
        "REDIS_URL",
        "TRUSTED_PROXY_HOPS",
        "TRUSTED_CLIENT_IP_HEADER",
        "EDURA_PROXY_SECRET",
        "API_SERVICE_URL",
        "ADMIN_API_SERVICE_URL",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "SMS_PROVIDER",
        "PAYMENTS_MODE",
        "PAYMOB_HMAC_SECRET",
        "PAYMOB_INTEGRATION_IDS",
        "WHATSAPP_MODE",
        "WHATSAPP_TOKEN",
        "WHATSAPP_PHONE_ID",
        "WHATSAPP_API_VERSION",
        "WALKIN_TOKEN_TTL_HOURS",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "FIREBASE_SERVICE_ACCOUNT_JSON",
        "NOTIFICATION_CHANNELS",
        "NOTIFICATIONS_PREVIEW",
        "NOTIFICATIONS_PREVIEW_DIR",
        "MAIL_REPLY_TO",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASS",
        "SMTP_SECURE",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "NEXT_PUBLIC_SENTRY_RELEASE",
        "SENTRY_TRACES_SAMPLE_RATE",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_PROJECT_SUPERADMIN",
        "SENTRY_AUTH_TOKEN",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "CI"
      ],
      "passThroughEnv": [
        "REALTIME_PORT",
        "PORT",
        "DIRECT_URL",
        "ADMIN_URL",
        "SEED_PASSWORD",
        "SEED_SUPERADMIN_EMAIL",
        "SEED_SUPERADMIN_PASSWORD",
        "SEED_ACCOUNTANT_EMAIL",
        "SEED_ACCOUNTANT_PASSWORD"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
