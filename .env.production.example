# production union — the source scripts/gen-vercel-env.py splits per app
#
# Template. Copy to .env.production and fill it with:
#   bun scripts/setup-env.ts
# Never put a real value in this file — it is the ONE .env* the repo tracks.

# --- Database
# Database (three strings, three jobs — see CLAUDE.md "DIRECT_URL IS THE OWNER STRING"):
#   ADMIN_URL / DIRECT_URL  owner role, migrations + tooling only, NEVER in a serving env
#   DATABASE_URL            the pooled `edura_app` string the app runs on (NOBYPASSRLS);
#                           `sslmode=require` is upgraded to verify-full at runtime (pg-ssl.ts)
# Production also REQUIRES (fail-closed): PAYMENTS_MODE, PAYMOB_HMAC_SECRET,
# PAYMOB_INTEGRATION_IDS, REALTIME_JWT_SECRET, INTERNAL_API_SECRET, CRON_SECRET,
# STUDENT_QR_SECRET, VIEW_AS_SECRET, REDIS_URL (rediss://), and an https NEXTAUTH_URL.
# Full list + reasons: CLAUDE.md "Env vars now REQUIRED in production".
ADMIN_URL=
DIRECT_URL=
DATABASE_URL=
APP_ROLE_PASSWORD=

# --- Database
DATABASE_DRIVER=ws
DATABASE_POOL_MAX=10
EDURA_ALLOW_DB_ENVS=
# --- Seed accounts
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
# --- App secrets
NEXTAUTH_SECRET=
SUPERADMIN_NEXTAUTH_SECRET=
STUDENT_QR_SECRET=
VIEW_AS_SECRET=
REALTIME_JWT_SECRET=
INTERNAL_API_SECRET=
CRON_SECRET=
# --- Payments
PAYMOB_HMAC_SECRET=
# --- Rate limiting
REDIS_URL=
TRUSTED_PROXY_HOPS=1
# --- Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Mail
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
MAIL_PROVIDER=smtp
MAIL_FROM=
# --- Observability
NEXT_PUBLIC_SENTRY_DSN=
# --- Web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# --- Payments (leave blank while mock)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMENTS_MODE=mock
# --- WhatsApp (leave blank while mock)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_MODE=mock
WHATSAPP_API_VERSION=v21.0
# --- URLs
NEXTAUTH_URL=https://edura-erp.vercel.app
APP_BASE_URL=https://edura-erp.vercel.app
APP_ORIGIN=https://edura-erp.vercel.app
APP_INTERNAL_URL=https://edura-erp.vercel.app
NEXT_PUBLIC_APP_URL=https://edura-erp.vercel.app
ERP_BASE_URL=https://edura-erp.vercel.app
SUPERADMIN_BASE_URL=https://edura-superadmin.vercel.app
MARKETING_SITE_URL=https://edura-www.vercel.app
NEXT_PUBLIC_APP_ORIGIN=https://edura-erp.vercel.app
NEXT_PUBLIC_SITE_URL=https://edura-www.vercel.app
NEXT_PUBLIC_REALTIME_URL=
REALTIME_INTERNAL_URL=
REALTIME_PORT=3005
# --- Invites
INVITE_CHANNELS=email
INVITE_TOKEN_TTL_HOURS=168
WALKIN_TOKEN_TTL_HOURS=168
GUARDIAN_EMAIL_GRACE_DAYS=14
GUARDIAN_REMINDER_EVERY_DAYS=3
