{
  "name": "edura-main",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "survey:dead-files": "bun run scripts/dead-file-survey.ts",
    "check:doc-links": "bun run scripts/check-doc-links.ts",
    "check:dead-code": "bunx --bun knip@5 --no-progress",
    "check:static-leaks": "bun run scripts/static-leak-check.ts",
    "check:i18n-dead-keys": "bun run scripts/i18n-dead-keys.ts",
    "setup:env": "bun run scripts/setup-env.ts",
    "setup:git-hooks": "bash scripts/setup-git-hooks.sh"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "flatted": "^3.4.2",
    "@hono/node-server": "^1.19.14",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.2",
    "fast-uri": "^3.1.6",
    "dompurify": "^3.4.14",
    "sharp": "^0.35.3",
    "valibot": "^1.4.2",
    "find-my-way": "^9.7.0"
  },
  "dependencies": {
    "brace-expansion": "^5.0.9"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/engines",
    "@swc/core",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
