{
  "name": "edura-main",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "minimatch@3": "^3.1.5",
    "flatted": "^3.4.2",
    "brace-expansion@1": "^1.1.16",
    "brace-expansion@2": "^2.1.4",
    "picomatch@2": "^2.3.2",
    "picomatch@4": "^4.0.5",
    "@hono/node-server": "^1.19.14",
    "postcss@8": "^8.5.20",
    "uuid@8": "^11.1.1",
    "sharp": "^0.35.3",
    "valibot": "^1.4.2",
    "find-my-way": "^9.7.0"
  },
  "dependencies": {
    "brace-expansion": "^5.0.9"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/engines",
    "@swc/core",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
