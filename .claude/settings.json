{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/Users/ali/edura}/.claude/hooks/graphify-session-digest.sh\"",
            "timeout": 15,
            "statusMessage": "Loading graphify orientation..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ali/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ali/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}