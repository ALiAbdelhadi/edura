# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
# NOTE: .env.test and .env.production hold real database credentials and MUST
# stay ignored — the earlier list only covered the *.local variants, which would
# have committed them. .env.example files are the committed, secret-free copies.
.env
.env.local
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local
.env.production.ready
!.env.example
!.env.*.example

# Testing
coverage
test-results
playwright-report

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Local claude config
.claude/settings.local.json

*.tsbuildinfo

# generated knowledge-graph artifacts (graphify tool output)
graphify-out/

# Showcase capture intermediates — the 2x PNGs Playwright writes (~20 MB).
# They are losslessly-captured ORIGINALS kept on disk so a re-encode never
# compounds artefacts from a lossy source, but the site ships only the
# optimised AVIF/WebP under opt/, which ARE committed.
apps/showcase/public/shots/**/*.png
apps/showcase/test-results/
apps/showcase/playwright-report/
apps/showcase/verify-out/
apps/showcase/.flows-raw/

# Showcase captures — the 2x PNG INTERMEDIATES only.
#
# `bun run capture` writes these, and `bun run optimize:shots` turns them into
# the AVIF/WebP the site actually serves. Only the optimised output is
# committed: it is what the pages reference, so it has to exist in a fresh
# clone, while the ~25 MB of source PNGs can always be regenerated.
apps/showcase/public/shots/**/*.png
apps/showcase/.auth/
